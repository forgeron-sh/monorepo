{
  "name": "forgeron-monorepo",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config --local core.hooksPath .git/hooks && lefthook install --force",
    "dev": "moon run :dev",
    "check": "moon run :typecheck --concurrency 3 && bun run lint && bun run format:check && bun run test && bun run knip && bun run deps && bun run deps:selftest && bun run neutral && bun run templates:check && bun run tokens:check",
    "test": "vitest run --maxWorkers=4",
    "build": "moon run :build",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "deps": "depcruise apps packages templates --config .dependency-cruiser.cjs",
    "deps:selftest": "bun scripts/deps-selftest.ts",
    "typecheck": "moon run :typecheck --concurrency 3",
    "deploy:staging": "bun run --filter '@forgeron/*' deploy:staging",
    "deploy:production": "bun run --filter '@forgeron/*' deploy:production",
    "neutral": "bun scripts/check-neutral.ts",
    "templates:check": "bun scripts/check-templates.ts",
    "tokens:check": "bun run --cwd packages/ui tokens:check",
    "packages:build": "bun run --cwd packages/manifest tsdown && bun run --cwd packages/runtime tsdown && bun run --cwd packages/sdk tsdown && bun run --cwd apps/cli tsdown && bun scripts/pack.ts",
    "packages:smoke": "bun scripts/smoke-packages.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@forgeron/tsconfig": "workspace:*",
    "@moonrepo/cli": "2.6.2",
    "dependency-cruiser": "18.6.0",
    "knip": "6.42.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "rolldown": "1.2.16",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.3"
}
