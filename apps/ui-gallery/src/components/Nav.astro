---
import { ForgeronIcon, toSvg } from "@forgeron/icons";
import { atoms } from "../registry";

interface Props {
  page: "home" | "identity" | "docs" | "blocks" | "charts";
}
const { page } = Astro.props;
const mark = toSvg(ForgeronIcon, { size: 22 }) ?? "";
---

<nav class="nav" aria-label="Main navigation">
  <div class="rail">
    <a href="/" class="nav-brand" aria-label="Forgeron UI, home">
      <span set:html={mark} />
      <span class="nav-word">Forgeron<span class="dim">/</span><span class="accent">UI</span></span>
    </a>
    <div class="nav-links t-mono">
      <a href="/identity/logo" aria-current={page === "identity" ? "page" : undefined}>/0.1 Identity</a>
      <a href={`/docs/${atoms[0]!.slug}`} aria-current={page === "docs" ? "page" : undefined}>/0.2 Atoms</a>
      <a href="/charts" aria-current={page === "charts" ? "page" : undefined}>/0.3 Charts</a>
      <a href="/blocks" aria-current={page === "blocks" ? "page" : undefined}>/0.4 Blocks</a>
    </div>
    <a class="btn btn-primary btn-sm nav-cta" href="/docs/installation">Install</a>
  </div>
</nav>
