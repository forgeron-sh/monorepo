---
import type { PropRow } from "../types";

interface Props {
  props: ReadonlyArray<PropRow>;
}
const { props } = Astro.props;
---

<div class="table-wrap">
  <table class="props">
    <thead>
      <tr>
        <th scope="col">Prop</th>
        <th scope="col">Type</th>
        <th scope="col">Default</th>
        <th scope="col">Description</th>
      </tr>
    </thead>
    <tbody>
      {
        props.map((p) => (
          <tr>
            <td>
              <code>{p.name}</code>
            </td>
            <td>
              <code class="dim-code">{p.type}</code>
            </td>
            <td>{p.default ? <code class="dim-code">{p.default}</code> : <span class="dim">—</span>}</td>
            <td>{p.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
