---
import { formatShortcut, Kbd } from "@forgeron/ui";
import DocsLayout from "../../components/DocsLayout.astro";
import CanvasDemo from "../../components/editors/CanvasDemo";
import { covers, keys, snippets, tables } from "../../components/editors/canvas-docs";
import { highlight } from "../../lib/highlight";
import "@forgeron/canvas/styles.css";
import "../../styles/editors.css";

const n = (i: number) => String(i + 1).padStart(2, "0");
---

<DocsLayout
  title="Canvas — Editors — Forgeron UI"
  description="The headless engine of the editors on an infinite surface: pan, zoom, grid, selection, move, resize, history, minimap."
  current="editors/canvas"
  page="editors"
>
  <header class="doc-head">
    <span class="t-mono dim">Editors <span class="accent">/</span> Canvas</span>
    <h1 class="f-title f-h3">Canvas</h1>
    <p class="t-lead">The infinite surface under every editor: camera, grid, selection, history. Items are yours.</p>
    <dl class="ed-facts t-mono">
      <div><dt class="dim">Package</dt><dd>@forgeron/canvas</dd></div>
      <div><dt class="dim">Layers</dt><dd>core (no React) · /react</dd></div>
      <div><dt class="dim">Used by</dt><dd>@forgeron/flow · @forgeron/draw · data hub schema</dd></div>
    </dl>
  </header>

  <section class="ed-block-stack" aria-label="Live">
    <div class="ed-stage ticks">
      <CanvasDemo client:visible />
    </div>
    <p class="ed-hint t-mono">
      <span><Kbd keys="Space" />drag to pan</span>
      <span><Kbd keys={["⌘", "wheel"]} />zoom</span>
      <span><Kbd keys="⌥" />drag a lasso</span>
      <span><Kbd keys={["⌘", "Z"]} />undo</span>
    </p>
  </section>

  <section class="ed-block-stack" aria-label="What it covers">
    <div class="spacer-sm t-mono dim"><span>/01 → What it covers</span></div>
    <ul class="ed-list">
      {covers.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <section class="ed-block-stack" aria-label="Use it">
    <div class="spacer-sm t-mono dim"><span>/02 → Use it</span></div>
    <div class="ed-snippets">
      {
        snippets.map((c, i) => {
          const id = `code-canvas-${i}`;
          return (
            <section class="frame" data-show="code" aria-label={c.title}>
              <header class="frame-bar">
                <span class="t-mono">
                  <span class="accent">/{n(i)}</span> <span class="dim">→</span> {c.title}
                </span>
                <div class="frame-tools">
                  <button type="button" class="btn btn-sm" data-copy={id}>
                    Copy
                  </button>
                </div>
              </header>
              <div class="frame-code" id={id} set:html={highlight(c.code, c.lang)} />
            </section>
          );
        })
      }
    </div>
  </section>

  <section class="ed-block-stack" aria-label="Keys">
    <div class="spacer-sm t-mono dim"><span>/03 → Keys</span></div>
    <div class="ed-keys">
      {
        keys.map((k) => (
          <div>
            <span>{k.label}</span>
            <Kbd keys={formatShortcut(k.combo)} />
          </div>
        ))
      }
    </div>
  </section>

  {
    tables.map((t, i) => (
      <section class="api" aria-labelledby={`api-${i}`}>
        <div class="spacer-sm t-mono dim">
          <span id={`api-${i}`}>API → {t.title}</span>
        </div>
        <div class="table-wrap">
          <table class="props">
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Default</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              {t.rows.map((r) => (
                <tr>
                  <td>
                    <code>{r.name}</code>
                  </td>
                  <td>{r.type ? <code class="dim-code">{r.type}</code> : <span class="dim">—</span>}</td>
                  <td>{r.default ? <code class="dim-code">{r.default}</code> : <span class="dim">—</span>}</td>
                  <td>{r.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <nav class="pager-nav t-mono" aria-label="Previous and next">
    <a href="/editors">← Every editor</a>
    <a href="/editors/blueprint">Blueprint →</a>
  </nav>
</DocsLayout>
