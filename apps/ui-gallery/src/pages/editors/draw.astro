---
import { formatShortcut, Kbd } from "@forgeron/ui";
import DocsLayout from "../../components/DocsLayout.astro";
import DrawDemo from "../../components/editors/DrawDemo";
import { drawCovers, drawKeys, drawSnippet } from "../../components/editors/draw-docs";
import { highlight } from "../../lib/highlight";
import "@forgeron/canvas/styles.css";
import "@forgeron/draw/styles.css";
import "../../styles/editors.css";
---

<DocsLayout
  title="Draw — Editors — Forgeron UI"
  description="The whiteboard on canvas: shapes, sticky notes, text, bound arrows, pixel pen, frames and images, with PNG and SVG export."
  current="editors/draw"
  page="editors"
>
  <header class="doc-head">
    <span class="t-mono dim">Editors <span class="accent">/</span> Draw</span>
    <h1 class="f-title f-h3">Draw</h1>
    <p class="t-lead">A whiteboard on the canvas. Board is built on it.</p>
    <dl class="ed-facts t-mono">
      <div><dt class="dim">Package</dt><dd>@forgeron/draw</dd></div>
      <div><dt class="dim">Layers</dt><dd>core (no React) · /react</dd></div>
      <div><dt class="dim">On</dt><dd>@forgeron/canvas · @forgeron/ui</dd></div>
    </dl>
  </header>

  <section class="ed-block-stack" aria-label="Live">
    <div class="ed-stage ed-stage-draw ticks">
      <DrawDemo client:only="react" />
    </div>
    <p class="ed-hint t-mono">
      <span><Kbd keys="R" />shape</span>
      <span><Kbd keys="A" />arrow</span>
      <span><Kbd keys="P" />pixel pen</span>
      <span><Kbd keys="F" />frame</span>
      <span>double-click to write</span>
    </p>
  </section>

  <section class="ed-block-stack" aria-label="What it covers">
    <div class="spacer-sm t-mono dim"><span>/01 → What it covers</span></div>
    <ul class="ed-list">
      {drawCovers.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <section class="ed-block-stack" aria-label="Use it">
    <div class="spacer-sm t-mono dim"><span>/02 → Use it</span></div>
    <section class="frame" data-show="code" aria-label="A board">
      <header class="frame-bar">
        <span class="t-mono"><span class="accent">/01</span> <span class="dim">→</span> A board</span>
        <div class="frame-tools">
          <button type="button" class="btn btn-sm" data-copy="code-draw-0">Copy</button>
        </div>
      </header>
      <div class="frame-code" id="code-draw-0" set:html={highlight(drawSnippet, "tsx")} />
    </section>
  </section>

  <section class="ed-block-stack" aria-label="Keys">
    <div class="spacer-sm t-mono dim"><span>/03 → Keys</span></div>
    <div class="ed-keys">
      {
        drawKeys.map((k) => (
          <div>
            <span>{k.label}</span>
            <Kbd keys={formatShortcut(k.combo)} />
          </div>
        ))
      }
    </div>
  </section>

  <nav class="pager-nav t-mono" aria-label="Previous and next">
    <a href="/editors/canvas">← Canvas</a>
    <a href="/editors/blueprint">Blueprint →</a>
  </nav>
</DocsLayout>
