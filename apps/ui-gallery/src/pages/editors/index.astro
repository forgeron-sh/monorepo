---
import { Database01Icon } from "@forgeron/icons";
import Layout from "../../components/Layout.astro";
import Planned from "../../components/Planned.astro";
import "../../styles/editors.css";

// Editors work on an infinite surface. Canvas is the engine they share; flow, draw and the data
// hub's schema diagram are built on it and come next.
const planned = [
  { name: "Schema", icon: Database01Icon, summary: "The data hub's tables and the relations between them." },
];
---

<Layout
  title="Editors — Forgeron UI"
  description="The editors that work on an infinite surface: the canvas engine they share, then flow, draw and the schema diagram."
  page="editors"
>
  <section class="rail">
    <header class="sec-head">
      <div class="sec-index" aria-hidden="true">/0.6</div>
      <div class="sec-title">
        <span class="tag"><b>Editors</b></span>
        <h1 class="f-title f-h2">One surface,<br />every editor.</h1>
      </div>
    </header>
  </section>
  <div class="rail spacer t-mono dim"><span>/0.6 → Every editor</span><span>[ Canvas, Flow, Draw, Blueprint, Rich text live ]</span></div>
  <section class="rail" aria-label="Editors">
    <ul class="grid">
      <li class="card">
        <div class="card-art ed-card-art dots-bg" aria-hidden="true">
          <svg viewBox="0 0 200 120" shape-rendering="crispEdges">
            <rect x="20.5" y="24.5" width="56" height="28" fill="var(--bg)" stroke="var(--line-strong)" />
            <rect x="96.5" y="24.5" width="56" height="28" fill="var(--bg)" stroke="var(--accent)" />
            <rect x="96.5" y="68.5" width="56" height="28" fill="var(--bg)" stroke="var(--line-strong)" />
            <rect x="149" y="49" width="7" height="7" fill="var(--bg)" stroke="var(--accent)" />
            <rect x="93" y="21" width="7" height="7" fill="var(--bg)" stroke="var(--accent)" />
            <rect x="140.5" y="88.5" width="44" height="20" fill="none" stroke="var(--line-strong)" />
            <rect x="152.5" y="94.5" width="20" height="8" fill="var(--accent)" stroke="none" />
            <rect x="156.5" y="96.5" width="8" height="4" fill="none" stroke="var(--bg)" />
          </svg>
        </div>
        <div class="card-copy">
          <span class="t-mono dim">/0.6.01 · headless + React</span>
          <a class="card-name card-link" href="/editors/canvas">Canvas</a>
          <span class="t-small">Pan, zoom, grid, selection, move, resize, history, minimap.</span>
        </div>
      </li>
      <li class="card">
        <div class="card-art ed-card-art dots-bg" aria-hidden="true">
          <svg viewBox="0 0 200 120" shape-rendering="crispEdges">
            <path d="M100 30 L140 50 L100 70 L60 50 Z" fill="var(--bg)" stroke="var(--line-strong)" />
            <path d="M60 50 L60 74 L100 94 L100 70 Z" fill="var(--bg-sunk)" stroke="var(--line-strong)" />
            <path d="M140 50 L140 74 L100 94 L100 70 Z" fill="var(--bg)" stroke="var(--line-strong)" />
            <path d="M100 38 L116 46 L100 54 L84 46 Z" fill="var(--accent)" stroke="none" />
            <rect x="150.5" y="88.5" width="36" height="16" fill="none" stroke="var(--accent)" />
          </svg>
        </div>
        <div class="card-copy">
          <span class="t-mono dim">/0.6.02 · on canvas + WASM</span>
          <a class="card-name card-link" href="/editors/blueprint">Blueprint</a>
          <span class="t-small">Open a .bp, four iso views, play, scrub, vars, hover tags.</span>
        </div>
      </li>
      <li class="card">
        <div class="card-art ed-card-art dots-bg" aria-hidden="true">
          <svg viewBox="0 0 200 120" shape-rendering="crispEdges">
            <rect x="16.5" y="46.5" width="44" height="24" fill="var(--bg)" stroke="var(--line-strong)" />
            <rect x="84.5" y="46.5" width="44" height="24" fill="var(--bg)" stroke="var(--accent)" />
            <rect x="148.5" y="22.5" width="40" height="24" fill="var(--bg)" stroke="var(--line-strong)" />
            <rect x="148.5" y="74.5" width="40" height="24" fill="var(--bg)" stroke="var(--line-strong)" />
            <path d="M60.5 58.5 H84.5" fill="none" stroke="var(--accent)" />
            <path d="M128.5 52.5 H138.5 V34.5 H148.5" fill="none" stroke="var(--line-strong)" />
            <path d="M128.5 64.5 H138.5 V86.5 H148.5" fill="none" stroke="var(--line-strong)" stroke-dasharray="2 2" />
            <rect x="57" y="55" width="7" height="7" fill="var(--bg)" stroke="var(--line-strong)" />
            <rect x="81" y="55" width="7" height="7" fill="var(--accent)" stroke="var(--accent)" />
          </svg>
        </div>
        <div class="card-copy">
          <span class="t-mono dim">/0.6.03 · on canvas</span>
          <a class="card-name card-link" href="/editors/flow">Flow</a>
          <span class="t-small">Steps as nodes, typed ports, edges, auto-layout, a run played on it.</span>
        </div>
      </li>
      <li class="card">
        <div class="card-art ed-card-art dots-bg" aria-hidden="true">
          <svg viewBox="0 0 200 120" shape-rendering="crispEdges">
            <rect x="18.5" y="20.5" width="164" height="80" fill="none" stroke="var(--line-strong)" />
            <rect x="18" y="20" width="165" height="8" fill="var(--bg-raised)" />
            <rect x="32.5" y="40.5" width="40" height="40" fill="var(--warning-subtle)" stroke="var(--warning)" />
            <rect x="32" y="40" width="41" height="3" fill="var(--warning)" />
            <path d="M80 60 H112" fill="none" stroke="var(--ink-muted)" />
            <path d="M108 56 L114 60 L108 64 Z" fill="var(--ink-muted)" />
            <rect x="118.5" y="44.5" width="48" height="32" fill="var(--bg)" stroke="var(--accent)" />
            <path d="M124 88h4v-4h4v-4h4v4h4v4h4v-4h4v-4h4" fill="none" stroke="var(--accent)" stroke-width="2" />
          </svg>
        </div>
        <div class="card-copy">
          <span class="t-mono dim">/0.6.04 · on canvas</span>
          <a class="card-name card-link" href="/editors/draw">Draw</a>
          <span class="t-small">Shapes, sticky notes, text, bound arrows, pixel pen, frames, export.</span>
        </div>
      </li>
      <li class="card">
        <div class="card-art ed-card-art dots-bg" aria-hidden="true">
          <svg viewBox="0 0 200 120" shape-rendering="crispEdges">
            <rect x="40.5" y="14.5" width="120" height="92" fill="var(--bg)" stroke="var(--line-strong)" />
            <rect x="52" y="26" width="44" height="6" fill="var(--ink)" />
            <rect x="52" y="42" width="96" height="3" fill="var(--line-strong)" />
            <rect x="52" y="50" width="84" height="3" fill="var(--line-strong)" />
            <rect x="52" y="64.5" width="6" height="6" fill="none" stroke="var(--accent)" />
            <rect x="64" y="66" width="60" height="3" fill="var(--line-strong)" />
            <rect x="52" y="78.5" width="6" height="6" fill="var(--accent)" stroke="var(--accent)" />
            <rect x="64" y="80" width="48" height="3" fill="var(--line-strong)" />
            <rect x="128" y="88" width="1" height="10" fill="var(--accent)" />
          </svg>
        </div>
        <div class="card-copy">
          <span class="t-mono dim">/0.6.05 · Tiptap + Yjs</span>
          <a class="card-name card-link" href="/editors/richtext">Rich text</a>
          <span class="t-small">Blocks, slash menu, marks, mentions, Markdown, collaboration.</span>
        </div>
      </li>
    </ul>
  </section>
  <div class="rail spacer t-mono dim"><span>/0.6 → Built on canvas</span><span>[ Soon ]</span></div>
  <section class="rail" aria-label="Planned editors">
    <Planned items={planned} index="/0.6" start={1} />
  </section>
</Layout>
