---
import Layout from "../../components/Layout.astro";
import ShaderGrid from "../../components/shaders/ShaderGrid.astro";
import { SHADER_GROUPS, shaders } from "../../lib/shaders";
import "../../styles/shaders.css";
---

<Layout
  title="Shaders — Forgeron UI"
  description="A fast, flexible way to render pixel shaders (the primitives), and real cases built on it to copy (the examples)."
  page="shaders"
>
  <section class="rail">
    <header class="sec-head">
      <div class="sec-index" aria-hidden="true">/0.2</div>
      <div class="sec-title">
        <span class="tag"><b>Shaders</b></span>
        <h1 class="f-title f-h2">Whole pixels,<br />never a blur.</h1>
      </div>
    </header>
  </section>
  {
    SHADER_GROUPS.map((g) => (
      <>
        <div class="rail spacer t-mono dim">
          <span>{g.index} → {g.title}</span>
          <span>[ {g.note} ]</span>
        </div>
        <section class="rail" aria-label={g.title}>
          <ShaderGrid index={g.index} items={shaders.filter((s) => s.group === g.id)} />
        </section>
      </>
    ))
  }
</Layout>
