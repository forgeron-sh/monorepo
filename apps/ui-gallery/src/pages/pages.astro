---
import Layout from "../components/Layout.astro";
import Planned from "../components/Planned.astro";
import { pages } from "../registry";
---

<Layout title="Pages — Forgeron UI" description="Whole screens of Forgeron apps, built from blocks. Coming next." page="pages">
  <section class="rail">
    <header class="sec-head">
      <div class="sec-index" aria-hidden="true">/0.8</div>
      <div class="sec-title">
        <span class="tag"><b>Pages</b> Soon</span>
        <h1 class="f-title f-h2">Whole screens,<br />ready to fork.</h1>
      </div>
    </header>
  </section>
  <div class="rail spacer t-mono dim"><span>/0.8 → Planned</span><span>[ Soon ]</span></div>
  <section class="rail" aria-label="Planned pages">
    <Planned items={pages} index="/0.8" />
  </section>
</Layout>
