---
import DocsLayout from "../../components/DocsLayout.astro";
import Frame from "../../components/Frame.astro";
import PropsTable from "../../components/PropsTable.astro";
import { examplesOf } from "../../lib/examples";
import { highlight } from "../../lib/highlight";
import { sourceOf } from "../../lib/sources";
import { atoms, blocks, groupOf, hooks } from "../../registry";
import type { Atom } from "../../types";

export function getStaticPaths() {
  const all = [...atoms, ...blocks, ...hooks];
  return all.map((atom, i) => ({
    params: { slug: atom.slug },
    props: { atom, prev: all[i - 1], next: all[i + 1] },
  }));
}

interface Props {
  atom: Atom;
  prev?: Atom;
  next?: Atom;
}
const { atom, prev, next } = Astro.props;
const examples = examplesOf(atom.slug).map((e, i) => ({
  ...e,
  index: `/${String(i + 1).padStart(2, "0")}`,
  code: highlight(sourceOf(e.id)),
}));
const importLine = `import { ${atom.imports.join(", ")} } from "@forgeron/ui";`;
---

<DocsLayout title={`${atom.name} — Forgeron UI`} description={atom.summary} current={atom.slug}
  page={groupOf(atom.slug) === "Blocks" ? "blocks" : "docs"}>
  <header class="doc-head">
    <span class="t-mono dim">{groupOf(atom.slug)} <span class="accent">/</span> {atom.name}</span>
    <h1 class="f-title f-h3">{atom.name}</h1>
    <p class="t-lead">{atom.summary}</p>
    <div class="hero-cmd">
      <div class="hero-cmd-code" id="import-line" set:html={highlight(importLine)} />
      <button type="button" class="btn btn-sm" data-copy="import-line">Copy</button>
    </div>
  </header>

  {examples.map((e) => <Frame id={e.id} index={e.index} title={e.title} code={e.code} />)}

  <section class="api" aria-labelledby="api-title">
    <div class="spacer-sm t-mono dim"><span id="api-title">API → Props</span></div>
    <PropsTable props={atom.props} />
  </section>

  <nav class="pager-nav t-mono" aria-label="Previous and next atom">
    {prev ? <a href={`/docs/${prev.slug}`}>← {prev.name}</a> : <a href="/docs/installation">← Installation</a>}
    {next ? <a href={`/docs/${next.slug}`}>{next.name} →</a> : <a href="/blocks">More blocks →</a>}
  </nav>
</DocsLayout>
