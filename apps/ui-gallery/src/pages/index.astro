---
import { Logo } from "@forgeron/ui";
import EntryGrid from "../components/EntryGrid.astro";
import Layout from "../components/Layout.astro";
import Planned from "../components/Planned.astro";
import ShaderGrid from "../components/shaders/ShaderGrid.astro";
import { highlight } from "../lib/highlight";
import { colors, identity } from "../lib/identity";
import { marketing } from "../lib/marketing";
import { shaders } from "../lib/shaders";
import { atoms, blocks, pages } from "../registry";
import "../styles/shaders.css";

const install = "bun add @forgeron/ui";
const swatches = colors.filter((c) => !c.value.dark.startsWith("var")).slice(0, 10);
const homeShaders = ["dither-field", "ember", "globe", "hearth"].flatMap((slug) => shaders.filter((s) => s.slug === slug));
---

<Layout
  title="Forgeron UI — components"
  description="The React components of Forgeron apps, in the lab design language: identity, atoms, blocks and pages."
  page="home"
>
  <section class="rail hero">
    <header class="sec-head">
      <div class="sec-index" aria-hidden="true">/0.0</div>
      <div class="sec-title">
        <span class="tag"><b>@forgeron/ui</b></span>
        <h1 class="f-title f-h1">The parts of<br />every app.</h1>
        <div class="hero-cmd">
          <div class="hero-cmd-code" id="hero-install" set:html={highlight(install, "shellscript")} />
          <button type="button" class="btn btn-sm" data-copy="hero-install">Copy</button>
        </div>
      </div>
    </header>
    <canvas class="hero-dither" data-dither data-px="4" aria-hidden="true"></canvas>
  </section>

  <div class="rail spacer t-mono dim"><span>/0.1 → Identity</span><span>[ Logo · colours · type · tokens · landing ]</span></div>
  <section class="rail" aria-label="Identity">
    <ul class="grid">
      {
        identity.map((p, i) => (
          <li class="card">
            <div class="card-art dots-bg" aria-hidden="true">
              {p.slug === "logo" && <Logo size={28} />}
              {p.slug === "colors" && (
                <span class="id-strip">
                  {swatches.map((c) => (
                    <span style={`background:${c.value.dark}`} />
                  ))}
                </span>
              )}
              {p.slug === "typography" && <span class="f-title f-h2">Aa</span>}
              {p.slug === "tokens" && (
                <span class="id-steps">
                  {[4, 8, 12, 16, 24, 32, 48].map((w) => (
                    <span style={`width:${w}px`} />
                  ))}
                </span>
              )}
            </div>
            <div class="card-copy">
              <span class="t-mono dim">/0.1.{String(i + 1).padStart(2, "0")}</span>
              <a class="card-name card-link" href={`/identity/${p.slug}`}>
                {p.name}
              </a>
              <span class="t-small">{p.summary}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="rail spacer t-mono dim"><span>/0.2 → Shaders</span><span>[ Live ]</span></div>
  <section class="rail" aria-label="Shaders">
    <ShaderGrid items={homeShaders} index="/0.2" />
    <a class="rail-more t-mono" href="/shaders">Every shader →</a>
  </section>

  <div class="rail spacer t-mono dim"><span>/0.3 → Atoms</span><span>[ Ready ]</span></div>
  <section class="rail" aria-label="Atoms">
    <EntryGrid entries={atoms} index="/0.3" />
  </section>

  <div class="rail spacer t-mono dim"><span>/0.4 → Blocks</span><span>[ Ready ]</span></div>
  <section class="rail" aria-label="Blocks">
    <EntryGrid entries={blocks} index="/0.4" />
    <a class="rail-more t-mono" href="/blocks">Every block →</a>
  </section>

  <div class="rail spacer t-mono dim"><span>/0.5 → Marketing</span><span>[ Ready ]</span></div>
  <section class="rail" aria-label="Marketing">
    <ul class="grid">
      {
        marketing.map((g, i) => (
          <li class="card">
            <div class="card-copy">
              <span class="t-mono dim">/0.5.{String(i + 1).padStart(2, "0")}</span>
              <a class="card-name card-link" href={`/marketing/${g.slug}`}>
                {g.name}
              </a>
              <span class="t-small">{g.summary}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <a class="rail-more t-mono" href="/marketing">The landing page, put together →</a>
  </section>

  <div class="rail spacer t-mono dim"><span>/0.6 → Pages</span><span>[ Soon ]</span></div>
  <section class="rail" aria-label="Pages, planned">
    <Planned items={pages.slice(0, 8)} index="/0.6" />
    <a class="rail-more t-mono" href="/pages">Every planned page →</a>
  </section>
</Layout>
