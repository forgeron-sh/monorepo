---
import { categories, manifest } from "@forgeron/icons/catalog";
import Coverage from "../components/Coverage";
import Layout from "../components/Layout.astro";
import SectionHead from "../components/SectionHead.astro";
import { countByCategory } from "../lib/search";

const done = manifest.filter((e) => e.implemented).length;
const duo = manifest.filter((e) => e.variants.duo).length;
const rows = countByCategory(manifest, categories).sort((a, b) => b.done / b.total - a.done / a.total || b.total - a.total);
const numbers = [
  { n: done.toLocaleString("en"), label: "icons drawn" },
  { n: (manifest.length - done).toLocaleString("en"), label: "stubs to draw" },
  { n: `${((done / manifest.length) * 100).toFixed(1)}%`, label: "of the catalog" },
  { n: String(duo), label: "with a duotone" },
];
/** Twenty squares per row of the table: the share drawn, in ember. */
const squares = (ratio: number, any: boolean) => {
  const filled = any ? Math.max(1, Math.round(ratio * 20)) : 0;
  return Array.from({ length: 20 }, (_, i) => i < filled);
};
---

<Layout title="Forgeron icons — coverage" description="What is drawn and what is still a stub, per category." page="coverage">
  <section class="rail">
    <SectionHead index="/0.2" label="Coverage" meta={`${rows.length} categories · our taxonomy`}>
      <h1 class="f-title f-h1">Drawn,<br />and still to draw.</h1>
      <p class="t-lead">
        One block per category, sized by its number of names. Each square is an icon; ember squares are drawn.
      </p>
    </SectionHead>
    <div class="numbers">
      {
        numbers.map((x) => (
          <div>
            <span class="num f-title">{x.n}</span>
            <span class="t-mono dim">{x.label}</span>
          </div>
        ))
      }
    </div>
    <div class="cov-wrap">
      <Coverage client:load />
    </div>
  </section>
  <div class="rail spacer t-mono dim"><span>/0.2 → Table</span><span>[ By share drawn ]</span></div>
  <section class="rail">
    <table class="cov-table">
      <thead class="t-mono dim">
        <tr><th>Category</th><th>Drawn</th><th>Names</th><th>Share</th><th class="cov-sq-h">Map</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td><a href={`/?category=${r.id}`}>{r.label}</a></td>
              <td class="t-code">{r.done > 0 ? <span class="accent">{r.done}</span> : <span class="dim">0</span>}</td>
              <td class="t-code muted">{r.total}</td>
              <td class="t-code muted">{((r.done / r.total) * 100).toFixed(1)}%</td>
              <td class="cov-sq" aria-hidden="true">
                {squares(r.done / r.total, r.done > 0).map((on) => <i class={on ? "on" : undefined} />)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Layout>
