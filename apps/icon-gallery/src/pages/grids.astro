---
import Layout from "../components/Layout.astro";
import Review from "../components/Review";
import SectionHead from "../components/SectionHead.astro";
import { GRID_STUDY } from "../lib/grid-study";
---

<Layout title="Forgeron icons — grids" description="The same subjects on 12, 16 and 24-pixel grids, side by side." page="grids">
  <section class="rail">
    <SectionHead index="/0.4" label="Grid study" meta="12 · 16 · 24 · 2026-11-16">
      <h1 class="f-title f-h1">Which grid<br />reads best?</h1>
      <p class="t-lead rv-intro">
        The same subjects drawn on 12, 16 and 24-pixel grids, at 16, 24 and 48 px. Study drawings, not exported by the
        package. The decision and its reasons are in <code>docs/icons.md</code>. Add <code>?loupe=1</code> to see the
        device pixels.
      </p>
    </SectionHead>
    <Review client:only="react" items={GRID_STUDY} />
  </section>
</Layout>
