---
import type { PixelIcon } from "@forgeron/icons";
import { getIcon, manifest } from "@forgeron/icons/catalog";
import Layout from "../components/Layout.astro";
import Review from "../components/Review";
import SectionHead from "../components/SectionHead.astro";

const items = manifest
  .filter((e) => e.implemented)
  .map((e) => ({ id: e.name, icon: getIcon(e.name) as PixelIcon }));
---

<Layout title="Forgeron icons — review" description="Every drawn icon at 16, 24 and 48 px, to review." page="review">
  <section class="rail">
    <SectionHead index="/0.3" label="Review" meta={`${items.length} drawn · 16 · 24 · 48 px`}>
      <h1 class="f-title f-h1">Read it<br />at 16 px.</h1>
      <p class="t-lead rv-intro">
        Every drawn icon at the sizes it must read at, in both tones, on dark and light. The 1× cells show what a
        screen with one device pixel per CSS pixel draws. The checklist is in <code>docs/icons.md</code>; keep a
        few icons with <code>?only=settings-01,cloudflare</code>.
      </p>
    </SectionHead>
    <Review client:only="react" items={items} />
  </section>
</Layout>
