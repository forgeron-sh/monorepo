---
// Tokens, atoms, blocks (the marketing group among them) and shaders, before the site's own composition.
import "@forgeron/ui/styles.css";
import "../styles/site.css";
import pixelMedium from "@forgeron/ui/fonts/ForgeSans-Medium.otf?url";

interface Props {
  title: string;
  description: string;
  /** Class on <body>: `home` gives the home page its roomier gutter. */
  bodyClass?: string;
  /** The picture of a shared link (Open Graph), a path or a URL. */
  image?: string;
  /** `article` for a blog post. */
  type?: "website" | "article";
}
const { title, description, bodyClass, image, type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Forgeron" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href={pixelMedium} as="font" type="font/otf" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Geist:wght@400;500;600&family=Silkscreen&display=swap"
    />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
