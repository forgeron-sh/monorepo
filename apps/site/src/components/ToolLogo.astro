---
import { Icon } from "@forgeron/ui";
import type { StackTool } from "../data/stack";

interface Props {
  tool: StackTool;
}
const { tool } = Astro.props;
---

<!-- A tool's logo in a square tile: its pixel brand mark (16-pixel grid, drawn at 16 px to stay
     sharp), or its initial when it has none. -->
<span class="tool-logo" aria-hidden="true">
  {
    tool.icon ? (
      <Icon icon={tool.icon} size={16} variant="mono" />
    ) : (
      <span class="tool-initial">{tool.name.slice(0, 1)}</span>
    )
  }
</span>

<style>
  .tool-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex: none;
    border: 1px solid var(--line-strong);
    background: var(--bg-sunk);
    color: var(--ink);
  }
  .tool-initial {
    font-family: var(--font-pixel);
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
  }
</style>
