    <div class="footer-cols">
      <div class="footer-col">
        <Label>Product</Label>
        <a class="navlink" href="#sdk">SDK</a>
        <a class="navlink" href="#templates">Templates</a>
        <a class="navlink" href="#hosting">Hosting</a>
