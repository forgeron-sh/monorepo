    <div class="footer-cols">
      <div class="footer-col">
        <Label>Produit</Label>
        <a class="navlink" href="#sdk">SDK</a>
        <a class="navlink" href="#modeles">Modèles</a>
        <a class="navlink" href="#hebergement">Hébergement</a>
      </div>
      <div class="footer-col">
        <Label>Développeurs</Label>
        <a class="navlink" href="#docs">Documentation</a>
        <a class="navlink" href="#github">GitHub</a>
        <a class="navlink" href="#docs">Changelog</a>
      </div>
      <div class="footer-col">
        <Label>Entreprise</Label>
        <a class="navlink" href="#docs">À propos</a>
