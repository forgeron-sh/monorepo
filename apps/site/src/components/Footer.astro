      <div class="footer-col">
        <Label>Developers</Label>
        <a class="navlink" href="#docs">Documentation</a>
        <a class="navlink" href="#github">GitHub</a>
        <a class="navlink" href="#docs">Changelog</a>
      </div>
      <div class="footer-col">
        <Label>Company</Label>
        <a class="navlink" href="#docs">About</a>
        <a class="navlink" href="#docs">Contact</a>
