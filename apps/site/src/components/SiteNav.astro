---
import { GithubIcon } from "@forgeron/icons";
import { Button, Icon, Logo } from "@forgeron/ui";

interface Props {
  /** The page's sections, or other pages, in the order they are read. */
  links: { href: string; label: string }[];
  /** Where "Get started" leads. */
  start: string;
  /** The public repository. */
  github: string;
  /** The link marked as the current page, if any. */
  current?: string;
}
const { links, start, github, current } = Astro.props;
---

<nav class="nav" aria-label="Main navigation">
  <div class="rail">
    <a href="/" aria-label="Forgeron, home"><Logo /></a>
    <div class="nav-links text-eyebrow">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.href === current ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="nav-actions">
      <Button href={github} size="sm"><Icon icon={GithubIcon} size={16} variant="mono" />GitHub</Button>
      <Button href={start} size="sm" variant="primary" marker>Get started</Button>
    </div>
  </div>
</nav>
