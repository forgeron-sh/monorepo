---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** An imported picture (`import shot from "./images/shot.png"`): a screenshot, a chart. */
  src?: ImageMetadata;
  /** Required with `src`: what the picture shows, for people who cannot see it. */
  alt?: string;
  /** An iso scene of `src/illustrations/scenes.ts`, played by Blueprint, instead of a picture. */
  scene?: string;
  /** One line under the figure. */
  caption?: string;
  /** Breaks out of the text column to the width of the article. */
  wide?: boolean;
}
const { src, alt = "", scene, caption, wide = false } = Astro.props;
---

<!-- Without `src` or `scene`, the figure frames its children: a code block, a table. -->
<figure class:list={["post-figure", { "post-figure-wide": wide }]}>
  <div class:list={["post-figure-frame fg-ticks", { "post-figure-scene fg-dots": scene }]}>
    {
      scene ? (
        <canvas data-iso={scene} data-scale="2" data-fill="0.8" data-unit="any" aria-hidden="true" />
      ) : src ? (
        <Image src={src} alt={alt} widths={[720, 1080, 1440]} sizes="(max-width: 1100px) 100vw, 1080px" />
      ) : (
        <slot />
      )
    }
  </div>
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>
