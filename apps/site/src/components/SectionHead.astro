---
import { PixelText } from "@forgeron/ui";

interface Props {
  /** The section's coordinate, `/0.1`, drawn in the pixel face. */
  index: string;
  meta?: string;
}
const { index, meta } = Astro.props;
---

<!-- A compact head: the coordinate on its own line, then the title and its lead, aligned on the gutter. -->
<header class="sec-head">
  <div class="sec-top">
    <span class="sec-index"><PixelText text={index} label={index} /></span>
    {meta && <span class="sec-meta text-eyebrow">{meta}</span>}
  </div>
  <div class="sec-title">
    <slot />
  </div>
</header>
