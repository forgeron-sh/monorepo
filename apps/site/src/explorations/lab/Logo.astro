---
import { pixelLogo, pixelText } from "./pixel";

interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<span class="logo" role="img" aria-label="Forgeron">
  <span class="mark" style={`width:${size}px;height:${size}px`} set:html={pixelLogo(12)} />
  <span class="word" style={`height:${Math.round(size * 0.5)}px;width:${Math.round(size * 0.5 * (47 / 7))}px`} set:html={pixelText("forgeron")} />
</span>
