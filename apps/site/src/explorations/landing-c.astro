---
import Footer from "./lab/Footer.astro";
import Icon from "./lab/Icon.astro";
import LabLayout from "./lab/LabLayout.astro";
import Logo from "./lab/Logo.astro";
import SectionHead from "./lab/SectionHead.astro";
import { pixelText } from "./lab/pixel";

/** Layers of the exploded stack, bottom (index 0) to top. */
const layers = [
  { i: 0, name: "Data", text: "Tables, and secrets held per person." },
  { i: 1, name: "Runtime", text: "Cloudflare Workers. Hosted by us or by you." },
  { i: 2, name: "Tools", text: "Versioned on every push, previewed before production." },
  { i: 3, name: "Access", text: "Company SSO, teams, permissions per action." },
  { i: 4, name: "Interfaces", text: "MCP, API, web and CLI from one definition." },
];
const left = [4, 2, 0].map((i) => layers[i]!);
const right = [3, 1].map((i) => layers[i]!);

const proof = [
  { icon: "anvil", text: "Open source · Apache-2.0" },
  { icon: "cloud", text: "Runs on Cloudflare Workers" },
  { icon: "lock", text: "Behind your company's SSO" },
  { icon: "layers", text: "MCP · API · Web · CLI" },
];

const doors = [
  { name: "MCP", iso: "mcp", icon: "mcp", text: "Your teams use the tool from Claude, with their own rights." },
  { name: "API", iso: "api", icon: "api", text: "A REST endpoint per action, for your scripts and other tools." },
  { name: "Web", iso: "web", icon: "web", text: "The tool's own web interface, behind your company's SSO." },
  { name: "CLI", iso: "cli", icon: "cli", text: "forgeron <tool> <action>, with --json for scripts." },
];

const teams = ["Sales", "Support", "Mgmt"];
const grants = [
  { name: "contacts.read", g: [1, 1, 1] },
  { name: "contacts.update", g: [1, 0, 1] },
  { name: "deals.move", g: [1, 0, 1] },
  { name: "deals.delete", g: [0, 0, 1] },
];

const deployments = [
  { v: "v1.5.0-rc.2", m: "Contacts CSV export", meta: "8dc01b2 · 4 min ago", env: "Preview", led: "warn" },
  { v: "v1.4.1", m: "Slimmer contact record", meta: "77c2d1a · yesterday", env: "Production", led: "ok" },
  { v: "v1.4.0", m: "deals.move action with history", meta: "a41f9e0 · Mon", env: "Production", led: "ok" },
];

const commands = [
  { cmd: "npx forgeron init --template crm", note: "a tool, its test and its CI" },
  { cmd: "forgeron dev", note: "runs locally, with local D1, KV, R2" },
  { cmd: "forgeron test", note: "builds, then runs Vitest" },
  { cmd: "forgeron deploy", note: "a version per push" },
  { cmd: "forgeron secrets set ODOO_API_KEY", note: "read from the keyboard, never an argument" },
  { cmd: "forgeron rollback --channel production", note: "back to the previous version" },
  { cmd: "forgeron preview close", note: "tears down a merged branch" },
  { cmd: 'forgeron crm contacts search "Durand"', note: "your tool, from the terminal" },
];

const audit = [
  { t: "14:09", who: "sophie@", what: "deals.move", tag: "write" },
  { t: "14:12", who: "marc@", what: "contacts.read", tag: "read" },
  { t: "14:16", who: "ci", what: "deploy v1.4.1", tag: "deploy" },
  { t: "14:21", who: "sophie@", what: "contacts.update", tag: "write" },
];

const hosting = [
  { k: "Cloudflare account", cloud: "Ours", self: "Yours" },
  { k: "A tool is", cloud: "Workers for Platforms", self: "A classic Worker" },
  { k: "Tool resources", cloud: "Dedicated D1, KV, R2", self: "Dedicated D1, KV, R2" },
  { k: "Installed by", cloud: "Nothing to install", self: "The forgeron CLI" },
];

const numbers = [
  { n: "1", label: "definition per tool" },
  { n: "4", label: "interfaces served" },
  { n: "1", label: "Worker per tool and environment" },
  { n: "0", label: "servers to manage" },
];

const templates = [
  { n: "01", name: "Lightweight CRM", path: "templates/crm", iso: "blocks", text: "Companies, contacts and leads, usable from Claude." },
  { n: "02", name: "Data hub", path: "templates/inventory", iso: "cube", text: "A business data repository, fed by imports and syncs." },
  { n: "03", name: "Dashboard", path: "templates/dashboard", iso: "bars", text: "A lightweight sales dashboard on top of the CRM." },
];

const faq = [
  {
    q: "What is a tool?",
    a: "A folder with a forgeron.config.ts and one file per action, each with its input and access level. Forgeron serves every action over MCP, a REST API, the web and the CLI.",
  },
  {
    q: "Do I need servers?",
    a: "No. Each tool runs as its own Cloudflare Worker, per environment, with dedicated D1, KV and R2.",
  },
  {
    q: "Can I host it myself?",
    a: "Yes. The same platform installs on your own Cloudflare account with the forgeron CLI. Or let us host it.",
  },
  {
    q: "How do my teams sign in?",
    a: "Through your company's SSO. Access is granted to teams, action by action, and usage is recorded in the audit log.",
  },
  {
    q: "Where do personal API keys go?",
    a: "Each person stores their own secrets, encrypted at rest. The CLI reads values from the keyboard, never from an argument.",
  },
  { q: "Is it open source?", a: "Yes, under the Apache-2.0 license." },
];
const resources = [
  { i: 0, icon: "database", name: "Database", cf: "D1", text: "One database per tool and environment, bound to its Worker." },
  { i: 1, icon: "bolt", name: "Cache", cf: "KV", text: "Key-value storage for what the tool reads often." },
  { i: 2, icon: "docs", name: "Files", cf: "R2", text: "One prefix per tool and environment, with size and type limits." },
  { i: 3, icon: "log", name: "Queue", cf: "Queues", text: "Work the tool hands off and runs in the background." },
  { i: 4, icon: "key", name: "Secrets", cf: "Encrypted", text: "The tool's own, or one per person, encrypted by the platform." },
];
---

<LabLayout title="Forgeron — Foundry v2 (lab C)" description="Landing exploration C: landing A, more room, more sections." variant="v2">
  <nav class="nav" aria-label="Main navigation">
    <div class="rail">
      <a href="#top" aria-label="Forgeron, home"><Logo /></a>
      <div class="nav-links t-mono">
        <a href="#system">System</a>
        <a href="#doors">Interfaces</a>
        <a href="#develop">Develop</a>
        <a href="#resources">Resources</a>
        <a href="#ship">Ship</a>
        <a href="#govern">Govern</a>
        <a href="#host">Host</a>
      </div>
      <div class="nav-actions">
        <a class="btn btn-sm" href="#github">GitHub</a>
        <a class="btn btn-sm btn-primary" href="#start"><span class="sq"></span>Get started</a>
      </div>
    </div>
  </nav>

  <main>
    <!-- HERO -->
    <section id="top" class="hero">
      <canvas data-shader="ember" data-px="5" aria-hidden="true"></canvas>
      <div class="rail hero-inner">
        <div class="hero-meta pad">
          <span class="tag"><b>N°01</b> Internal tools platform</span>
          <span class="tag">v0.2 · <b>Lab</b></span>
        </div>
        <div class="hero-copy pad">
          <h1 class="f-title f-hero">Forge your<br />internal tools.</h1>
          <p class="t-lead">Write a tool once. Your teams use it from Claude, the API, the web and the terminal.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#start"><span class="sq"></span>Get started</a>
            <span class="cmd"><span class="p">$</span>npx forgeron init</span>
          </div>
        </div>
        <div class="hero-foot pad t-mono dim">
          <span>Scroll ↓</span>
          <span>/0.1 System</span>
        </div>
      </div>
    </section>

    <!-- PROOF STRIP -->
    <section class="rail proof">
      {
        proof.map((p) => (
          <div>
            <Icon name={p.icon} size={24} />
            <span class="t-mono">{p.text}</span>
          </div>
        ))
      }
    </section>

    <!-- 0.1 SYSTEM -->
    <section id="system" class="rail">
      <SectionHead index="/0.1" label="System" meta="5 layers · 1 tool">
        <h2 class="f-title f-h2">One tool,<br />five layers.</h2>
        <p class="sec-lead">Everything a business tool needs, stacked once, so your developers only write the actions.</p>
      </SectionHead>
      <div class="stack">
        <ul class="stack-col">
          {
            left.map((l) => (
              <li data-layer={l.i}>
                <span class="t-mono accent">0{l.i + 1}</span>
                <span class="t-title">{l.name}</span>
                <span class="t-small">{l.text}</span>
              </li>
            ))
          }
        </ul>
        <div class="stack-art dots-bg">
          <canvas id="stack-canvas" data-iso="stack" data-cycle="2.4" data-fill="0.8" aria-hidden="true"></canvas>
        </div>
        <ul class="stack-col stack-col-r">
          {
            right.map((l) => (
              <li data-layer={l.i}>
                <span class="t-mono accent">0{l.i + 1}</span>
                <span class="t-title">{l.name}</span>
                <span class="t-small">{l.text}</span>
              </li>
            ))
          }
          <li class="stack-empty" aria-hidden="true"></li>
        </ul>
      </div>
    </section>

    <div class="rail spacer t-mono dim"><span>/0.1 → /0.2</span><span>[ Interfaces ]</span></div>

    <!-- 0.2 DOORS -->
    <section id="doors" class="rail">
      <SectionHead index="/0.2" label="Interfaces" meta="1 definition · 4 doors">
        <h2 class="f-title f-h2">Pick a door.</h2>
        <p class="sec-lead">The same actions, the same rights, wherever your teams already work.</p>
      </SectionHead>
      <div class="doors">
        {
          doors.map((d, i) => (
            <article class="door ticks">
              <div class="door-art dots-bg">
                <span class="door-fig t-mono dim">FIG.0{i + 1}</span>
                <canvas data-iso={d.iso} data-fill="0.74" aria-hidden="true" />
              </div>
              <div class="door-copy">
                <div class="door-head">
                  <Icon name={d.icon} size={24} />
                  <span class="t-mono dim">0{i + 1}</span>
                </div>
                <h3 class="f-title f-h3">{d.name}</h3>
                <p class="t-small">{d.text}</p>
              </div>
              <a class={i === 0 ? "btn btn-primary door-btn" : "btn door-btn"} href="#start">
                Explore {d.name}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 0.3 IN PRACTICE (bento) -->
    <section id="interfaces" class="rail">
      <SectionHead index="/0.3" label="In practice" meta="A day with a tool">
        <h2 class="f-title f-h2">Where your<br />teams already are.</h2>
      </SectionHead>
      <div class="bento">
        <article class="cell c4 r3">
          <span class="corner t-mono dim">FIG.05 · Gateway</span>
          <div class="corner-r row">
            <span class="chip on">MCP</span><span class="chip">API</span><span class="chip">Web</span><span class="chip">CLI</span>
          </div>
          <div class="art"><canvas data-iso="network" data-fill="0.78" aria-hidden="true"></canvas></div>
          <div class="copy">
            <h3 class="t-title">One definition, four interfaces</h3>
            <p class="t-small">Every action is served over MCP, REST, the web and the terminal.</p>
          </div>
        </article>
        <article class="cell c2 r3">
          <span class="corner t-mono dim">Claude</span>
          <div class="art chat dots-bg">
            <div class="msg me t-code">Move the Durand deal to Won.</div>
            <div class="msg tool t-mono">
              <span class="led hot"></span> crm.deals.move
              <span class="dim">write · Sales</span>
            </div>
            <div class="msg t-code muted">Done. Durand → Won, logged in the deal history.</div>
          </div>
          <div class="copy hr">
            <h3 class="t-title">From the conversation</h3>
            <p class="t-small">Your teams ask; the tool acts, with their rights.</p>
          </div>
        </article>
        <article class="cell c3 r2">
          <span class="corner t-mono dim">Permissions</span>
          <div class="art perms">
            <table class="t-mono">
              <thead>
                <tr><th></th>{teams.map((t) => <th>{t}</th>)}</tr>
              </thead>
              <tbody>
                {
                  grants.map((r) => (
                    <tr>
                      <td>{r.name}</td>
                      {r.g.map((v) => (
                        <td>
                          <span class={v ? "px on" : "px"} />
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="copy hr"><h3 class="t-title">Teams × actions, nothing more</h3></div>
        </article>
        <article class="cell c3 r2">
          <span class="corner t-mono dim">Environments</span>
          <div class="corner-r row t-bit"><span class="led ok"></span> prod <span class="led warn"></span> preview</div>
          <div class="art"><canvas data-iso="blocks" data-fill="0.86" aria-hidden="true"></canvas></div>
          <div class="copy hr"><h3 class="t-title">Preview, then production</h3></div>
        </article>
      </div>
    </section>

    <div class="rail spacer t-mono dim"><span>/0.3 → /0.4</span><span>[ Develop ]</span></div>

    <!-- 0.4 DEVELOP -->
    <section id="develop" class="rail">
      <SectionHead index="/0.4" label="Develop" meta="TypeScript SDK">
        <h2 class="f-title f-h2">Write actions,<br />not plumbing.</h2>
      </SectionHead>
      <div class="feat">
        <div class="feat-copy">
          <p class="t-lead">
            A tool is a <code>forgeron.config.ts</code> and one file per action: its input, its access level, its run. Interfaces, access and hosting come with it.
          </p>
          <a class="link" href="#docs">Read the SDK →</a>
          <div class="code">
            <div class="code-head">
              <span class="t-mono dim">crm/actions/deals/move.ts</span>
              <span class="tag">crm · v1.4.0</span>
            </div>
            <pre><code><span class="k">import</span> {"{"} action, z {"}"} <span class="k">from</span> <span class="s">"@forgeron/sdk"</span>;

<span class="k">export default</span> action({"{"}
  description: <span class="s">"Moves a lead to a new stage."</span>,
  access: <span class="s">"write"</span>,
  input: z.object({"{"} id: z.string(), stage: z.enum([<span class="s">"won"</span>, <span class="s">"lost"</span>]) {"}"}),
  cli: {"{"} args: [<span class="s">"id"</span>, <span class="s">"stage"</span>] {"}"},
  <span class="k">async</span> run(ctx) {"{"}
    <span class="c">/* … */</span>
  {"}"},
{"}"});</code></pre>
          </div>
        </div>
        <div class="feat-art dots-bg"><canvas data-iso="module" data-fill="0.72" aria-hidden="true"></canvas></div>
      </div>
      <ul class="feat-list">
        <li><Icon name="cli" /><span class="t-title">Local first</span><span class="t-small"><code>forgeron dev</code> runs the tool on your machine, with local D1, KV and R2.</span></li>
        <li><Icon name="shield" /><span class="t-title">Typed inputs</span><span class="t-small">Each action declares its input with Zod; the same schema drives MCP, the API and the CLI options.</span></li>
        <li><Icon name="check" /><span class="t-title">Tested in CI</span><span class="t-small"><code>forgeron test</code> builds the tool, then runs Vitest against the real Worker.</span></li>
      </ul>
    </section>

    <!-- 0.5 RESOURCES -->
    <section id="resources" class="rail">
      <SectionHead index="/0.5" label="Resources" meta="Declared, or absent">
        <h2 class="f-title f-h2">Declared,<br />or absent.</h2>
        <p class="sec-lead">
          A tool lists everything it asks of the platform, like an app's permissions. What is not declared does not
          exist at runtime.
        </p>
      </SectionHead>
      <div class="res">
        <div class="res-art dots-bg">
          <span class="door-fig t-mono dim">FIG.10 · Tool and resources</span>
          <canvas id="res-canvas" data-iso="resources" data-cycle="1.6" data-scale="2" data-fill="0.92" aria-hidden="true"></canvas>
        </div>
        <ul class="res-list">
          {
            resources.map((r) => (
              <li data-res={r.i}>
                <Icon name={r.icon} />
                <div>
                  <span class="t-title">{r.name}</span> <span class="t-mono dim">{r.cf}</span>
                  <p class="t-small">{r.text}</p>
                </div>
              </li>
            ))
          }
          <li class="res-ghost">
            <Icon name="shield" />
            <div>
              <span class="t-title">Not declared</span> <span class="t-mono dim">Ghost</span>
              <p class="t-small">Absent: <code>ctx.db</code> without a database, <code>ctx.fetch</code> refuses unlisted hosts.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="res-code">
        <div class="code">
          <div class="code-head">
            <span class="t-mono dim">forgeron.config.ts · resources</span>
            <span class="tag">Declaration</span>
          </div>
          <pre><code>resources: {"{"}
  db: database({"{"} engine: <span class="s">"d1"</span>, why: <span class="s">"Companies, contacts and leads"</span> {"}"}),
  files: bucket({"{"} maxSize: <span class="s">"25MB"</span>, why: <span class="s">"Lead attachments"</span> {"}"}),
  cache: kv(),
  userSecrets: {"{"}
    ODOO_API_KEY: {"{"} label: <span class="s">"Odoo API key"</span>, why: <span class="s">"Read your Odoo tickets"</span> {"}"},
  {"}"},
  network: {"{"} allow: [<span class="s">"api.hubspot.com"</span>] {"}"},
{"}"}</code></pre>
        </div>
        <div class="code">
          <div class="code-head">
            <span class="t-mono dim">What the admin sees</span>
            <span class="tag">Console · admin MCP</span>
          </div>
          <pre><code><span class="k">CRM v1.4.0 requests:</span>
  Database (D1)              <span class="c">Companies, contacts and leads</span>
  File storage (25 MB)       <span class="c">Lead attachments</span>
  One Odoo API key per person <span class="c">Read your Odoo tickets</span>
  Outbound calls: api.hubspot.com</code></pre>
        </div>
      </div>
      <div class="feat">
        <div class="feat-copy">
          <span class="tag"><b>Approval</b></span>
          <h3 class="f-title f-h3">Asking for more<br />waits at the gate.</h3>
          <p class="t-lead">
            A resource added or broadened puts the version pending approval. It runs in preview, and reaches
            production once an admin accepts it. A removed resource asks for nothing.
          </p>
          <span class="cmd"><span class="p">$</span>forgeron approve crm 1.5.0</span>
        </div>
        <div class="feat-art dots-bg"><canvas data-iso="gate" data-fill="0.8" aria-hidden="true"></canvas></div>
      </div>
    </section>

    <!-- 0.6 SHIP -->
    <section id="ship" class="rail">
      <SectionHead index="/0.6" label="Ship" meta="Every push is a version">
        <h2 class="f-title f-h2">Push, preview,<br />ship.</h2>
      </SectionHead>
      <div class="pipe dots-bg">
        <canvas data-iso="pipeline" data-fill="0.8" aria-hidden="true"></canvas>
        <span class="pin t-mono" style="top:14%;left:calc(50% + 70px)"><i></i>Repository</span>
        <span class="pin t-mono accent" style="top:58%;left:calc(50% - 300px)"><i></i>Preview · per branch</span>
        <span class="pin t-mono" style="top:52%;left:calc(50% + 170px)"><i></i>Production</span>
      </div>
      <ul class="feat-list">
        <li><Icon name="branch" /><span class="t-title">A preview per branch</span><span class="t-small">The GitHub Action tests and deploys each push to its branch's own channel.</span></li>
        <li><Icon name="deploy" /><span class="t-title">Releases go to production</span><span class="t-small">A release of the branch production follows updates it, by itself or by an admin.</span></li>
        <li><Icon name="rollback" /><span class="t-title">One command back</span><span class="t-small"><code>forgeron rollback</code> returns a channel to the version it served before.</span></li>
      </ul>
      <ul class="deploys">
        {
          deployments.map((d) => (
            <li>
              <span class="t-mono">{d.v}</span>
              <span>{d.m}</span>
              <span class="t-bit">
                <span class={`led ${d.led}`} /> {d.env}
              </span>
              <span class="t-mono dim">{d.meta}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="rail spacer t-mono dim"><span>/0.6 → /0.7</span><span>[ Govern ]</span></div>

    <!-- 0.6 GOVERN -->
    <section id="govern" class="rail">
      <SectionHead index="/0.7" label="Govern" meta="Access · secrets · audit">
        <h2 class="f-title f-h2">Who did what,<br />with which rights.</h2>
        <p class="sec-lead">Every interface goes through the same gateway: SSO, team check, audit log. None bypasses another.</p>
      </SectionHead>
      <div class="trust">
        <article class="trust-card">
          <div class="trust-art dots-bg">
            <div class="mock signin">
              <Logo size={20} />
              <span class="t-mono dim">Sign in to your workspace</span>
              <span class="btn btn-ink btn-sm">Continue with company SSO</span>
            </div>
          </div>
          <div class="trust-copy">
            <Icon name="lock" />
            <h3 class="t-title">Company SSO</h3>
            <p class="t-small">Your teams sign in with the identity provider you already use. No new passwords.</p>
          </div>
        </article>
        <article class="trust-card">
          <div class="trust-art dots-bg">
            <div class="mock secrets t-mono">
              <div><span>ODOO_API_KEY</span><span class="dim">••••••••</span></div>
              <div><span>CRM_TOKEN</span><span class="dim">••••••••</span></div>
              <div class="dim"><span>names only</span><span>encrypted</span></div>
            </div>
          </div>
          <div class="trust-copy">
            <Icon name="key" />
            <h3 class="t-title">Secrets per person</h3>
            <p class="t-small">Each person keeps their own API keys, encrypted at rest. Listings show names only.</p>
          </div>
        </article>
        <article class="trust-card">
          <div class="trust-art dots-bg">
            <div class="mock audit t-mono">
              {
                audit.map((a) => (
                  <div>
                    <span class="dim">{a.t}</span>
                    <span>{a.who}</span>
                    <span>{a.what}</span>
                    <span class={a.tag === "write" ? "accent" : "dim"}>{a.tag}</span>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="trust-copy">
            <Icon name="log" />
            <h3 class="t-title">Audit log</h3>
            <p class="t-small">Usage, deployments and every change to the workspace are recorded, with who made them.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- 0.7 TERMINAL -->
    <section id="cli" class="rail">
      <SectionHead index="/0.8" label="Terminal" meta="forgeron CLI">
        <h2 class="f-title f-h2">The whole life<br />of a tool, typed.</h2>
      </SectionHead>
      <div class="term-wrap">
        <div class="term-copy pad">
          <p class="t-lead">From the first scaffold to the rollback, the CLI does it, locally or in CI.</p>
          <span class="cmd"><span class="p">$</span>npx forgeron init</span>
        </div>
        <div class="term-roll" aria-label="forgeron commands">
