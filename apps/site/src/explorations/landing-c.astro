<script>
  // Keep the stack labels in step with the highlighted layer, and let a label pick its layer.
  import { isoCanvas } from "../illustrations/canvas";

  const stack = isoCanvas(document.getElementById("stack-canvas"));
  const items = document.querySelectorAll<HTMLElement>("[data-layer]");
  stack?.onActive((active) => {
    for (const li of items) li.classList.toggle("on", Number(li.dataset.layer) === active);
  });
  for (const li of items) {
    li.addEventListener("mouseenter", () => stack?.select(Number(li.dataset.layer)));
    li.addEventListener("mouseleave", () => stack?.select(-1));
  }
</script>

<script>
  // Resource legend in step with the highlighted resource; hovering a line picks it.
  import { isoCanvas } from "../illustrations/canvas";

  const res = isoCanvas(document.getElementById("res-canvas"));
  const rows = document.querySelectorAll<HTMLElement>("[data-res]");
  res?.onActive((active) => {
    for (const li of rows) li.classList.toggle("on", Number(li.dataset.res) === active);
  });
  for (const li of rows) {
    li.addEventListener("mouseenter", () => res?.select(Number(li.dataset.res)));
    li.addEventListener("mouseleave", () => res?.select(-1));
  }
</script>

