---
import { GithubIcon, MinusSignIcon, PlusSignIcon, Tick01Icon } from "@forgeron/icons";
import { Button, Command, Icon, PixelText, Title } from "@forgeron/ui";
import Footer from "../components/Footer.astro";
import SectionHead from "../components/SectionHead.astro";
import SiteNav from "../components/SiteNav.astro";
import { GITHUB, plans, SELF_HOST } from "../data/plans";
import { FORGERON_SEAT, READ_ON, stack } from "../data/stack";
import Logo from "../components/ToolLogo.astro";
import Stepper from "../components/Stepper.astro";
import { AI_READ_ON, aiCost, aiExample, aiModels, aiSources, BALANCE, fmt, lineCost, meterGroups, money, scenarioCost, scenarios } from "../data/usage";
import Site from "../layouts/Site.astro";

const DOCS = "https://github.com/forgeron-sh/monorepo/blob/main/docs/sdk.md";

/** Why Forgeron Cloud: what Cloudflare's platform gives every tool, and what we add on top. */
const reasons = [
  {
    iso: "host-cloud",
    name: "Updates, applied for you",
    text: "New versions of the platform and security patches land without you lifting a finger.",
  },
  {
    iso: "isolated",
    name: "A Worker per tool",
    text: "Each tool runs on its own, per environment, with its own database, files and cache.",
  },
  {
    iso: "bolt",
    name: "No cold starts",
    text: "Workers run on V8 isolates: a tool answers at once, even after a quiet night.",
  },
  {
    iso: "drawer",
    name: "Files without egress fees",
    text: "Cloudflare charges no egress on Workers: files go out as often as your teams need.",
  },
  {
    iso: "safe",
    name: "One vault",
    text: "Application secrets and each person's keys, sealed by the platform.",
  },
  {
    iso: "dashboard",
    name: "Every call, measured",
    text: "Calls, time per call, errors and logs, per tool, with no setup.",
  },
];

/**
 * Cloudflare's network, read on 17 Nov 2026: cloudflare.com/network (cities, latency,
 * interconnections), cloudflare.com/products/workers (cold starts),
 * developers.cloudflare.com/workers/platform/pricing (egress, updated 13 Nov 2026).
 */
const network = [
  { n: "348", label: "cities in the network" },
  { n: "50MS", label: "from 95% of Internet users" },
  { n: "13K+", label: "network interconnections" },
  { n: "0", label: "cold starts, on V8 isolates" },
];

/** What each plan includes: true, false, or a word. */
const compare: { group: string; rows: { name: string; v: (boolean | string)[] }[] }[] = [
  {
    group: "Your tools",
    rows: [
      { name: "Tools from the catalog", v: [true, true, true] },
      { name: "Web, CLI, MCP and API", v: [true, true, true] },
      { name: "Recipes and plugins", v: ["Soon", "Soon", "Soon"] },
    ],
  },
  {
    group: "Access",
    rows: [
      { name: "Company SSO and teams", v: [true, true, true] },
      { name: "Audit log", v: [true, true, true] },
      { name: "One vault for secrets", v: [true, true, true] },
    ],
  },
  {
    group: "Running it",
    rows: [
      { name: "Cloudflare's network", v: [true, true, false] },
      { name: "Updates and patches applied for you", v: [true, false, false] },
      { name: "Data in your own account or servers", v: [false, true, true] },
      { name: "Priority support", v: [true, false, false] },
    ],
  },
  {
    group: "Price",
    rows: [
      { name: "Per seat, per month", v: ["$14.99", "$0", "$0"] },
      { name: "Available", v: ["Now", "Now", "Soon"] },
    ],
  },
];

/** The three rules of Fuel, each with its scene. */
const fuelRules = [
  {
    iso: "fuel-month",
    tag: "Each month",
    name: "Included, not carried over",
    text: `Your plan tops up your ${BALANCE} every month. What is left of it at the end of the month does not roll over.`,
  },
  {
    iso: "fuel-topup",
    tag: "On top",
    name: "Top-ups last a year",
    text: "Dollars you add on top stay valid for twelve months, used after the month's own.",
  },
  {
    iso: "fuel-pool",
    tag: BALANCE,
    name: "One balance for everything",
    text: "AI and compute, every tool and every person draw on the same dollars. One person's heavy month is not a surcharge on their seat.",
  },
];

const faq = [
  {
    q: "What is a seat?",
    a: "A person who used at least one tool during the month, through any interface. Members who did not use a tool that month are not counted.",
  },
  {
    q: "Is self-managed really free?",
    a: "Yes. Forgeron is open source under the Apache-2.0 license. Cloudflare bills your account directly, at its own prices, for what your tools use.",
  },
  {
    q: "What is the difference with Forgeron Cloud?",
    a: "The same platform. On Forgeron Cloud we run it: updates, patches and resources are handled for you, with priority support and one bill per seat.",
  },
  {
    q: "What happens to the Fuel I do not use?",
    a: "What your plan includes each month does not carry over to the next. What you add on top stays valid for twelve months.",
  },
  {
    q: "When will the own-servers mode be ready?",
    a: "It is in the works. Follow the repository on GitHub to hear when it ships.",
  },
];
---

<Site
  title="Pricing — Forgeron"
  description="Forgeron Cloud at $14.99 per seat per month, or free and open source on your own Cloudflare account."
  bodyClass="home"
>
  <SiteNav
    github={GITHUB}
    start="#plans"
    current="/pricing"
    links={[
      { href: "/#how", label: "How it works" },
      { href: "/#develop", label: "Develop" },
      { href: "#plans", label: "Plans" },
      { href: "#savings", label: "Savings" },
      { href: "#fuel", label: "Fuel" },
      { href: "#why", label: "Why Cloud" },
      { href: "#compare", label: "Compare" },
      { href: "/pricing", label: "Pricing" },
    ]}
  />

  <main class="pricing">
    <!-- 0.1 PLANS -->
    <section id="plans" class="rail">
      <SectionHead index="/0.1">
        <Title as="h1" size="h2">Per seat,<br />or free.</Title>
        <p class="sec-lead">Let us run Forgeron for you, or run it yourself. The same platform, the same tools.</p>
      </SectionHead>
      <div class="plans">
        {
          plans.map((p, i) => (
            <article class:list={["plan ticks", { featured: i === 0 }]}>
              <div class="plan-art dots-bg">
                <canvas data-iso={p.iso} data-scale="2" data-fill="0.8" data-unit="any" aria-hidden="true" />
              </div>
              <div class="plan-head">
                <Icon icon={p.icon} size={24} />
                <span class="plan-name"><PixelText text={p.name} label={p.name} /></span>
                {p.tag && <span class:list={["plan-tag text-bit", { soon: p.tag === "Soon" }]}>{p.tag}</span>}
              </div>
              <p class="plan-where text-small muted">{p.where}</p>
              <div class="price">
                <div class="price-n">
                  <PixelText text={p.price} label={p.price} />
                </div>
                <span class="text-eyebrow dim">{p.unit}</span>
              </div>
              {p.groups.map((g) => (
                <div class="plan-group">
                  <span class="text-eyebrow dim">{g.title}</span>
                  <ul class="plan-list">
                    {g.items.map((it) => (
                      <li class="text-small">
                        <Icon icon={Tick01Icon} size={12} />
                        {it}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <Button href={p.action.href} size="lg" variant={p.action.primary ? "primary" : "secondary"} className="plan-btn">
                {p.action.label}
              </Button>
            </article>
          ))
        }
      </div>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.1 → /0.2</span><span>[ Savings ]</span></div>

    <!-- 0.2 SAVINGS: pick the tools the team pays for, set the seats, compare with Forgeron Cloud. -->
    <section id="savings" class="rail">
      <SectionHead index="/0.2">
        <Title as="h2" size="h2">What you<br />would save.</Title>
        <p class="sec-lead">Pick the tools your team pays for today, set the seats, and compare with Forgeron Cloud.</p>
      </SectionHead>
      <div class="sim">
        <div class="sim-pick">
          {
            stack.map((g) => (
              <div class="sim-group">
                <span class="text-eyebrow dim">{g.name}</span>
                <div class="sim-chips">
                  {g.tools.map((tool) => (
                    <button type="button" class="sim-chip" data-tool={tool.id} aria-pressed="false">
                      <Logo tool={tool} />
                      <span>{tool.name}</span>
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
          <ul class="sim-rows" aria-label="Your tools">
            {
              stack.flatMap((g) =>
                g.tools.map((tool) => (
                  <li class="sim-row" data-row={tool.id} hidden>
                    <Logo tool={tool} />
                    <span class="sim-name">
                      <span class="text-title-3">{tool.name}</span>
                      <span class="text-eyebrow dim">{tool.plan}</span>
                    </span>
                    <Stepper label={`${tool.name} seats`} value={10} />
                    <span class="sim-cost text-code" data-cost />
                  </li>
                )),
              )
            }
            <li class="sim-empty text-small muted" data-empty>Pick a tool above to add it here.</li>
          </ul>
        </div>
        <aside class="sim-bill ticks" aria-live="polite">
          <div class="bill-line">
            <span class="text-eyebrow dim">Today, per month</span>
            <span class="bill-n" data-today>$0</span>
          </div>
          <div class="bill-line">
            <span class="text-eyebrow dim">Forgeron Cloud, per month</span>
            <span class="bill-n" data-forgeron>$0</span>
            <div class="bill-people">
              <span class="text-small muted">People on the team</span>
              <Stepper label="People on the team" value={10} people />
            </div>
          </div>
          <div class="bill-save">
            <span class="text-eyebrow" data-save-label>You save, per year</span>
            <span class="bill-big" data-year>$0</span>
            <span class="text-small muted" data-month>$0 per month</span>
          </div>
        </aside>
      </div>
      <details class="sim-sources">
        <summary class="text-eyebrow dim">Prices and sources, read on {READ_ON}</summary>
        <ul>
          {
            stack.flatMap((g) =>
              g.tools.map((tool) => (
                <li class="text-small">
                  <span>{tool.name} {tool.plan}</span>
                  <span class="muted">{tool.note}</span>
                  <a href={tool.source} rel="noopener" target="_blank">{new URL(tool.source).host}</a>
                </li>
              )),
            )
          }
          <li class="text-small muted">
            Forgeron Cloud: ${FORGERON_SEAT} per seat per month. Prices in USD, before tax. Logos drawn in pixels after the brands' marks;
            the marks belong to their owners.
          </li>
        </ul>
      </details>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.2 → /0.3</span><span>[ Fuel ]</span></div>

    <!-- 0.3 FUEL: one balance in dollars, for AI and compute alike. -->
    <section id="fuel" class="rail">
      <SectionHead index="/0.3">
        <Title as="h2" size="h2">Fuel,<br />in dollars.</Title>
        <p class="sec-lead">
          On Forgeron Cloud, everything your tools use, AI models and compute alike, burns {BALANCE}: one balance per
          workspace, in US dollars, drawn as it is used.
        </p>
      </SectionHead>
      <ul class="use-rules">
        {
          fuelRules.map((r) => (
            <li class="use-rule ticks">
              <div class="use-rule-art dots-bg">
                <canvas data-iso={r.iso} data-scale="2" data-fill="0.74" data-unit="any" aria-hidden="true" />
              </div>
              <div class="use-rule-copy">
                <span class="text-eyebrow accent">{r.tag}</span>
                <h3 class="text-title-3">{r.name}</h3>
                <p class="text-small muted">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="use-part">
        <header class="use-head">
          <span class="text-eyebrow dim">/A · AI models</span>
          <h3 class="text-title-2">Tokens, priced per model.</h3>
          <p class="text-small muted">
            Every call a tool makes to a model is counted in tokens: what it reads (input), what it writes (output), and what
            the provider serves from its cache, read for a fraction of the input price. In US dollars per million tokens:
          </p>
        </header>
        <div class="ai-table" role="table" aria-label="AI models, US dollars per million tokens">
          <div class="ai-row ai-headrow text-eyebrow dim" role="row">
            <span role="columnheader">Model</span>
            <span role="columnheader">Input</span>
            <span role="columnheader">Output</span>
            <span role="columnheader">Cache read</span>
            <span role="columnheader">Cache write</span>
          </div>
          {
            aiModels.map((m) => (
              <div class="ai-row" role="row">
                <span role="rowheader" class="ai-model">
                  <span class="ai-logo" aria-hidden="true"><Icon icon={m.icon} size={16} variant="mono" /></span>
                  <span class="text-small">{m.model}</span>
                  <span class="text-eyebrow dim">{m.provider}</span>
                </span>
                <span role="cell" class="text-code">{fmt(m.input)}</span>
                <span role="cell" class="text-code">{fmt(m.output)}</span>
                <span role="cell" class="text-code">{fmt(m.cacheRead)}</span>
                <span role="cell" class="text-code">{m.cacheWrite === null ? <span class="dim">—</span> : fmt(m.cacheWrite)}</span>
              </div>
            ))
          }
        </div>
        <div class="ai-example">
          <p class="text-small muted"><span class="text-eyebrow accent">Example</span> {aiExample.text}</p>
          <ul>
            {
              aiExample.models.map((name) => {
                const m = aiModels.find((x) => x.model === name)!;
                return (
                  <li>
                    <span class="text-small">{m.model}</span>
                    <span class="use-n">{money(aiCost(m))}</span>
                    <span class="text-eyebrow dim">a month</span>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>

      <div class="use-part">
        <header class="use-head">
          <span class="text-eyebrow dim">/B · Compute</span>
          <h3 class="text-title-2">Everything else, by the unit.</h3>
          <p class="text-small muted">
            Requests, CPU time, the database, files, cache, realtime, queues, mail and logs: each has a price per unit, taken
            from the same {BALANCE} as AI. A tool that sleeps costs nothing; a busy one pays for what it does.
          </p>
        </header>
        <div class="meters">
          {
            meterGroups.map((g) => (
              <div class="meter-group ticks">
                <span class="meter-head text-eyebrow">
                  <Icon icon={g.icon} size={16} />
                  {g.resource}
                </span>
                <ul>
                  {g.meters.map((m) => (
                    <li>
                      <span class="text-small">{m.name}</span>
                      <span class="text-eyebrow dim">{m.unit}</span>
                      <span class="text-code meter-n">{m.usd === 0 ? "Free" : fmt(m.usd)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="scenarios">
          {
            scenarios.map((sc) => (
              <article class="scenario ticks">
                <h4 class="text-title-3">{sc.name}</h4>
                <p class="text-small muted">{sc.text}</p>
                <ul>
                  {sc.lines.map((l) => (
                    <li class="text-small">
                      <span>{l.label}</span>
                      <span class="text-code">{money(lineCost(l))}</span>
                    </li>
                  ))}
                </ul>
                <div class="scenario-total">
                  <span class="text-eyebrow dim">A month</span>
                  <span class="use-n">{money(scenarioCost(sc))}</span>
                </div>
              </article>
            ))
          }
        </div>
      </div>
      <details class="sim-sources">
        <summary class="text-eyebrow dim">AI prices and sources, read on {AI_READ_ON}</summary>
        <ul>
          {
            aiSources.map((src) => (
              <li class="text-small">
                <span>{src.provider}</span>
                <a href={src.url} rel="noopener" target="_blank">{new URL(src.url).host}</a>
              </li>
            ))
          }
          <li class="text-small muted">
            Prices in US dollars, before tax. Cache write: the shortest-lived cache each provider lists. {BALANCE} applies to
            Forgeron Cloud; on a self-managed install, your own accounts bill you. Logos drawn in pixels after the brands'
            marks; the marks belong to their owners.
          </li>
        </ul>
      </details>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.3 → /0.4</span><span>[ Why Forgeron Cloud ]</span></div>

    <!-- 0.2 WHY FORGERON CLOUD -->
    <section id="why" class="rail">
      <SectionHead index="/0.4">
        <Title as="h2" size="h2">Built on<br />Cloudflare.</Title>
        <p class="sec-lead">What Cloudflare's platform gives every tool, and what we take off your plate.</p>
      </SectionHead>
      <div class="reasons">
        {
          reasons.map((r) => (
            <article class="reason ticks">
              <div class="reason-art dots-bg">
                <canvas data-iso={r.iso} data-scale="2" data-fill="0.74" data-unit="any" aria-hidden="true" />
              </div>
              <div class="reason-copy">
                <h3 class="text-title-3">{r.name}</h3>
                <p class="text-small muted">{r.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.4 → /0.5</span><span>[ Network ]</span></div>

    <!-- 0.3 NETWORK -->
    <section id="network" class="rail">
      <SectionHead index="/0.5">
        <Title as="h2" size="h2">Close to<br />every team.</Title>
        <p class="sec-lead">Every tool runs on Cloudflare's network: near your teams, with nothing to keep running.</p>
      </SectionHead>
      <div class="net">
        <div class="net-art"><canvas data-shader="globe" data-px="4" aria-hidden="true"></canvas></div>
        <div class="net-facts">
          <ul class="net-grid">
            {
              network.map((f) => (
                <li class="ticks">
                  <div class="num"><PixelText text={f.n} label={f.n} /></div>
                  <span class="text-eyebrow dim">{f.label}</span>
                </li>
              ))
            }
          </ul>
          <p class="net-source text-eyebrow dim">
            Source: cloudflare.com/network, Workers product and pricing pages, read 17 Nov 2026.
          </p>
        </div>
      </div>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.5 → /0.6</span><span>[ Compare ]</span></div>

    <!-- 0.4 COMPARE -->
    <section id="compare" class="rail">
      <SectionHead index="/0.6">
        <Title as="h2" size="h2">Side<br />by side.</Title>
      </SectionHead>
      <div class="cmp" role="table" aria-label="Plans compared">
        <div class="cmp-row cmp-head" role="row">
          <span role="columnheader"></span>
          {
            plans.map((p) => (
              <span role="columnheader" class="text-eyebrow">
                <Icon icon={p.icon} size={12} />
                {p.name}
              </span>
            ))
          }
        </div>
        {
          compare.map((g) => (
            <>
              <div class="cmp-group text-eyebrow dim" role="row">
                <span role="rowheader">{g.group}</span>
              </div>
              {g.rows.map((r) => (
                <div class="cmp-row" role="row">
                  <span role="rowheader" class="text-small">
                    {r.name}
                  </span>
                  {r.v.map((v) => (
                    <span role="cell" class="cmp-cell">
                      {v === true ? (
                        <Icon icon={Tick01Icon} size={12} title="Included" />
                      ) : v === false ? (
                        <span class="dim" aria-label="Not included">
                          —
                        </span>
                      ) : (
                        <span class:list={["text-eyebrow", { soon: v === "Soon" }]}>{v}</span>
                      )}
                    </span>
                  ))}
                </div>
              ))}
            </>
          ))
        }
      </div>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.6 → /0.7</span><span>[ Open source ]</span></div>

    <!-- 0.5 OPEN SOURCE -->
    <section id="open-source" class="rail oss">
      <canvas data-shader="dissolve" data-px="8" aria-hidden="true"></canvas>
      <div class="oss-inner">
        <span class="text-eyebrow dim">/0.7 · Open source</span>
        <Title as="h2" size="h2">All of it,<br />Apache-2.0.</Title>
        <p class="text-small muted oss-lead">
          The platform, the SDK, the CLI and the templates are open source. Read the code, run it on your own account, or
          contribute.
        </p>
        <div class="oss-actions">
          <Button href={GITHUB} size="lg" variant="primary"><Icon icon={GithubIcon} size={16} variant="mono" />GitHub</Button>
          <Button href={SELF_HOST} size="lg">Read the install guide</Button>
          <Command>npx forgeron init</Command>
        </div>
      </div>
    </section>

    <!-- 0.6 QUESTIONS -->
    <section id="faq" class="rail">
      <SectionHead index="/0.8">
        <Title as="h2" size="h2">Questions,<br />answered.</Title>
      </SectionHead>
      <div class="faq">
        {
          faq.map((f, i) => (
            <details open={i === 0}>
              <summary>
                <span class="text-eyebrow accent">Q.0{i + 1}</span>
                <span class="text-title-3">{f.q}</span>
                <span class="faq-mark" aria-hidden="true">
                  <Icon icon={PlusSignIcon} variant="mono" className="faq-closed" />
                  <Icon icon={MinusSignIcon} variant="mono" className="faq-opened" />
                </span>
              </summary>
              <p class="text-small muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <Footer github={GITHUB} docs={DOCS} from="/0.8" />
</Site>

<script>
  // Mounts every canvas of the page (scenes, fields), once.
  import "../illustrations/canvas";
  import { FORGERON_SEAT, stack } from "../data/stack";

  // Plans: every description takes the height of the tallest, so the prices start on one line.
  const wheres = [...document.querySelectorAll<HTMLElement>(".plan-where")];
  const evenWheres = () => {
    for (const el of wheres) el.style.minHeight = "";
    const tallest = Math.max(0, ...wheres.map((el) => el.offsetHeight));
    for (const el of wheres) el.style.minHeight = `${tallest}px`;
  };
  evenWheres();
  window.addEventListener("resize", evenWheres);
  void document.fonts.ready.then(evenWheres);

  // Savings: the tools picked, their seats, and the team on Forgeron Cloud.
  const sim = document.querySelector<HTMLElement>("#savings");
  if (sim) {
    const tools = new Map(stack.flatMap((g) => g.tools).map((t) => [t.id, t]));
    const usd = (n: number) => `$${Math.round(n).toLocaleString("en-US")}`;
    const field = (el: Element | null) => el?.querySelector<HTMLInputElement>("input");
    const read = (input: HTMLInputElement | null | undefined) =>
      Math.max(0, Math.min(9999, Math.floor(Number(input?.value) || 0)));
    const people = field(sim.querySelector("[data-stepper=people]"));
    // The team follows the largest tool until someone sets it by hand.
    let peopleSet = false;
    const set = (sel: string, text: string) => {
      const el = sim.querySelector(sel);
      if (el) el.textContent = text;
    };
    const update = () => {
      let today = 0;
      let largest = 0;
      let any = false;
      for (const row of sim.querySelectorAll<HTMLElement>("[data-row]")) {
        if (row.hidden) continue;
        any = true;
        const seats = read(field(row));
        largest = Math.max(largest, seats);
        const cost = tools.get(row.dataset.row ?? "")?.cost(seats) ?? 0;
        today += cost;
        const out = row.querySelector("[data-cost]");
        if (out) out.textContent = `${usd(cost)} / mo`;
      }
      const empty = sim.querySelector<HTMLElement>("[data-empty]");
      if (empty) empty.hidden = any;
      if (!peopleSet && people) people.value = String(largest);
      const ours = read(people) * FORGERON_SEAT;
      const save = today - ours;
      set("[data-today]", usd(today));
      set("[data-forgeron]", usd(ours));
      set("[data-save-label]", save >= 0 ? "You save, per year" : "Forgeron costs more, per year");
      set("[data-year]", usd(Math.abs(save) * 12));
      set("[data-month]", `${usd(Math.abs(save))} per month`);
      sim.querySelector(".bill-save")?.classList.toggle("loss", save < 0);
    };
    for (const chip of sim.querySelectorAll<HTMLButtonElement>("[data-tool]")) {
      chip.addEventListener("click", () => {
        const on = chip.getAttribute("aria-pressed") !== "true";
        chip.setAttribute("aria-pressed", String(on));
        const row = sim.querySelector<HTMLElement>(`[data-row="${chip.dataset.tool}"]`);
        if (row) row.hidden = !on;
        update();
      });
    }
    for (const stepper of sim.querySelectorAll<HTMLElement>("[data-stepper]")) {
      const input = field(stepper);
      const isPeople = stepper.dataset.stepper === "people";
      for (const btn of stepper.querySelectorAll<HTMLButtonElement>("[data-step]")) {
        btn.addEventListener("click", () => {
          if (!input) return;
          input.value = String(Math.max(0, read(input) + Number(btn.dataset.step)));
          if (isPeople) peopleSet = true;
          update();
        });
      }
      input?.addEventListener("input", () => {
        if (isPeople) peopleSet = true;
        update();
      });
    }
    // A stack to start from, so the page opens on a real comparison.
    for (const id of ["linear", "notion", "zendesk"])
      sim.querySelector<HTMLButtonElement>(`[data-tool="${id}"]`)?.click();
  }
</script>

