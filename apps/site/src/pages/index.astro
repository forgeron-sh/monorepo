---
import { Badge, Button, EnvTag, Label, Logo } from "@forgeron/ui";
import { CodeCard } from "../components/CodeCard";
import { ExampleTabs } from "../components/ExampleTabs";
import Footer from "../components/Footer.astro";
import Frame from "../components/Frame.astro";
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";

const templates = [
  { path: "templates/crm", name: "Lightweight CRM", text: "Companies, contacts and leads, usable from Claude." },
  {
    path: "templates/odoo-gateway",
    name: "Odoo gateway",
    text: "Query Odoo from Claude with each person's own API key.",
  },
  {
    path: "templates/inventory",
    name: "Data hub",
    text: "A business data repository, fed by imports and syncs.",
  },
  { path: "templates/dashboard", name: "Dashboard", text: "A lightweight sales dashboard on top of the CRM." },
];

const deployments = [
  { version: "v1.5.0-rc.2", message: "Contacts CSV export", meta: "8dc01b2 · 4 min ago", env: "preview", state: "warning" },
  { version: "v1.4.1", message: "Slimmer contact record", meta: "77c2d1a · yesterday", env: "pilot", state: "success" },
  { version: "v1.4.0", message: "deals.move action with history", meta: "a41f9e0 · Mon", env: "production", state: "success" },
] as const;

const roles = ["Sales", "Support", "Management"];
const permissions = [
  { name: "contacts.read", kind: "Read", grants: [true, true, true] },
  { name: "contacts.update", kind: "Write", grants: [true, false, true] },
  { name: "deals.delete", kind: "Delete", grants: [false, false, true] },
];

const viewCode = [
  'import { defineView, useAction } from "forgeron/react";',
  "",
  "export default defineView({",
  '  name: "pipeline",',
  "  render() {",
  '    const deals = useAction("crm.deals.list");',
  "    return <Kanban columns={deals.byStage()} />;",
  "  },",
  "});",
];
---

<Base
  title="Forgeron — forge your internal tools"
  description="Forge your internal tools once. Use them from Claude, the API, the web and the terminal."
>
  <Header />

  <main>
    <section id="top" class="wrap hero">
      <Badge mono dot>Open source · Powered by Cloudflare Workers</Badge>
      <h1>Forge your internal tools.</h1>
      <p>
        Write a tool once with the Forgeron SDK. It's versioned, deployed on Cloudflare and exposed over MCP,
        API, web and CLI, behind your company's SSO.
      </p>
      <div class="hero-actions">
        <Button href="#start" variant="primary" size="lg">Get started for free</Button>
        <span class="command text-code"><span class="muted">$</span>npx forgeron init</span>
      </div>
    </section>

    <section id="product" class="wrap" style="padding-bottom: 96px;">
      <ExampleTabs client:visible />
    </section>

    <section class="wrap section stack-3" style="gap: 48px;">
      <div class="section-head center stack-3">
        <Label>Why Forgeron</Label>
        <h2 class="display-section">Your teams talk to Claude. They no longer need an ERP.</h2>
        <p class="lead">
          When the interface becomes the conversation, what matters is that data and actions work.
          Not the size of the software suite behind them.
        </p>
      </div>
      <Frame class="compare">
        <div>
          <Label>Today</Label>
          <h3 class="muted">A giant suite, paid per module.</h3>
          <ul class="muted">
            <li><span class="text-code-inline" aria-hidden="true">—</span>Licenses for modules nobody opens</li>
            <li><span class="text-code-inline" aria-hidden="true">—</span>A fixed interface, heavy to adapt</li>
            <li><span class="text-code-inline" aria-hidden="true">—</span>A custom integration for every need</li>
            <li><span class="text-code-inline" aria-hidden="true">—</span>No clean access from an AI assistant</li>
          </ul>
        </div>
        <div class="invert">
          <Label>With Forgeron</Label>
          <h3>Light tools, forged to fit.</h3>
          <ul>
            <li><span class="check check-inv" aria-hidden="true"></span>Only the tools you need: CRM, contact records, data</li>
            <li><span class="check check-inv" aria-hidden="true"></span>Usable from Claude, an API, the terminal or a web interface</li>
            <li><span class="check check-inv" aria-hidden="true"></span>Editable by your developers, versioned on every push</li>
            <li><span class="check check-inv" aria-hidden="true"></span>Hosted by us or by you, open source</li>
          </ul>
        </div>
      </Frame>
    </section>

    <section class="wrap section stack-3" style="gap: 40px;">
      <div class="section-head">
        <Label>How it works</Label>
        <h2 class="display-section">From repo to production, with no infrastructure to manage.</h2>
        <p class="lead">
          Forgeron sits on top of Cloudflare Workers. You push your code; the platform versions it,
          applies access rules and serves it everywhere.
        </p>
      </div>
      <Frame class="flow">
        <div class="node" style="flex: 1 1 180px;">
          <Label>01 · Code</Label>
          <strong>Your GitHub repo</strong>
          <span class="text-code-inline muted">forgeron.config.ts</span>
        </div>
        <div class="wire" aria-hidden="true"></div>
        <div class="node invert" style="flex: 1.4 1 240px;">
          <Label>02 · Forgeron</Label>
          <strong>The platform</strong>
          <div class="row-wrap">
            {["Versions", "Access", "SSO", "Logs", "Connectors"].map((c) => <Badge mono>{c}</Badge>)}
          </div>
        </div>
        <div class="wire" aria-hidden="true"></div>
        <div class="node" style="flex: 1 1 180px;">
          <Label>03 · Runtime</Label>
          <strong>Cloudflare Workers</strong>
          <span class="text-small muted">One worker per tool and per environment</span>
        </div>
        <div class="wire" aria-hidden="true"></div>
        <div class="stack-3" style="flex: 1.2 1 220px; gap: var(--space-2);">
          {
            [
              ["Claude", "MCP"],
              ["Your apps", "API"],
              ["Browser", "Web"],
              ["Terminal", "CLI"],
            ].map(([who, iface]) => (
              <div class="node sm">
                <strong>{who}</strong>
                <Badge mono>{iface}</Badge>
              </div>
            ))
          }
        </div>
      </Frame>
    </section>

    <section class="wrap section two-col">
      <div class="col">
        <div class="stack-3">
          <Label>Versions</Label>
          <h2 class="display-block">Every push becomes a version.</h2>
          <p class="muted">
            Test in preview, open a pilot to a group, then go to production. Rolling back takes
            one click.
          </p>
        </div>
        <div class="card">
          {
            deployments.map((d) => (
              <div class="deploy">
                <span class="ver text-code-inline">{d.version}</span>
                <span class="msg">
                  <strong>{d.message}</strong>
                  <span class="text-code-inline muted">{d.meta}</span>
                </span>
                <EnvTag env={d.env} />
                {d.state === "warning" ? (
                  <Badge tone="warning" dot>Building</Badge>
                ) : (
                  <Badge tone="success" dot>Live</Badge>
                )}
              </div>
            ))
          }
        </div>
      </div>
      <div class="col">
        <div class="stack-3">
          <Label>Access</Label>
          <h2 class="display-block">Who can do what, action by action.</h2>
          <p class="muted">
            Permissions are declared in the SDK and set in the dashboard. Sign-in through your company
            SSO, with a log of who uses which tool.
          </p>
        </div>
        <div class="card scroll-x">
          <table class="perm">
            <thead>
              <tr>
                <th scope="col" style="text-align: left;" class="text-caption">Action</th>
                {roles.map((r) => <th scope="col" class="text-caption">{r}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                permissions.map((p) => (
                  <tr>
                    <th scope="row">
                      <span class="name text-code-inline">{p.name}</span>
                      <span class="text-caption muted">{p.kind}</span>
                    </th>
                    {p.grants.map((granted) => (
                      <td>
                        <span
                          class={granted ? "check check-on" : "check"}
                          role="img"
                          aria-label={granted ? "Allowed" : "Denied"}
                        />
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="templates" class="wrap section stack-3" style="gap: 40px;">
      <div class="head-row">
        <div class="section-head">
          <Label>Templates</Label>
          <h2 class="display-section">Start from a base. Forge the rest.</h2>
        </div>
        <Button href="#templates">See all templates</Button>
      </div>
      <div class="grid-4">
        {
          templates.map((t) => (
            <a href="#templates" class="card">
              <span class="text-code-inline muted">{t.path}</span>
              <span class="text-title-3">{t.name}</span>
              <span class="muted">{t.text}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section id="sdk" class="wrap section split">
      <div class="stack-3" style="gap: 20px;">
        <Label>Views</Label>
        <h2 class="display-section" style="font-size: clamp(32px, 4.5vw, 44px);">
          Lightweight dashboards, in React.
        </h2>
        <p class="lead">
          When a conversation isn't enough, write a React page. The SDK injects the tool's data, with
          the signed-in person's permissions.
        </p>
        <div class="row-wrap" style="gap: var(--space-2);">
          <Badge mono>useAction</Badge><Badge mono>useUser</Badge><Badge mono>defineView</Badge>
        </div>
      </div>
      <Frame class="frame-pad">
        <CodeCard title="views/pipeline.tsx" lines={viewCode} />
      </Frame>
    </section>

    <section id="hosting" class="wrap section stack-3" style="gap: 40px;">
      <div class="section-head center stack-3">
        <Label>Hosting</Label>
        <h2 class="display-section">Ours or yours.</h2>
      </div>
      <div class="grid-2">
        <div class="card tile">
          <Label>Self-host</Label>
          <span class="display-block">Open source</span>
          <span class="muted">
            Deploy Forgeron on your own Cloudflare account. The SDK, the platform and the templates are open.
          </span>
          <Button href="#github" class="push">View on GitHub</Button>
        </div>
        <div class="card tile invert">
          <Label>Forgeron Cloud</Label>
          <span class="display-block">
            [PRICE] € <span class="text-body muted" style="letter-spacing: 0;">/ seat / month</span>
          </span>
          <span class="muted">
            One plan: all tools, connectors, enterprise SSO and versions, hosted for you.
          </span>
          <Button href="#start" class="push on-invert">Get started</Button>
        </div>
      </div>
    </section>

    <section id="start" class="wrap" style="padding-top: 32px; padding-bottom: 96px;">
      <Frame class="cta">
        <Logo variant="symbol" size={56} />
        <h2>Your first tool in five minutes.</h2>
        <div class="hero-actions">
          <Button href="#start" variant="primary" size="lg">Get started for free</Button>
          <Button href="#docs" size="lg">Read the docs</Button>
        </div>
      </Frame>
    </section>
  </main>

  <Footer />
</Base>
