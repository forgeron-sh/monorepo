<script>
  // Mounts every canvas of the page (scenes, fields), once.
  import "../illustrations/canvas";
</script>

<script>
  // The anatomy: a row of the legend, or the drawing under the pointer, opens the stack on a layer.
  import { isoCanvas } from "../illustrations/canvas";

  const canvas = document.getElementById("stack-canvas");
  const stack = isoCanvas(canvas);
  const items = [...document.querySelectorAll<HTMLElement>("[data-layer]")];
  let picked = -1;
  const pick = (n: number) => {
    if (n === picked) return;
    picked = n;
    stack?.select(n);
    for (const li of items) li.classList.toggle("on", Number(li.dataset.layer) === n);
  };
  // A row of the legend picks its layer; leaving the legend lets the stack close again.
  for (const li of items) li.addEventListener("mouseenter", () => pick(Number(li.dataset.layer)));
  for (const col of document.querySelectorAll(".stack-col")) col.addEventListener("mouseleave", () => pick(-1));
  // The drawing itself: the height under the pointer picks the layer (top of the drawing is the
  // first layer). The stack fills about the middle seven tenths of the canvas height.
  canvas?.addEventListener("mousemove", (e) => {
    const r = canvas.getBoundingClientRect();
    const y = (e.clientY - r.top) / r.height;
    const k = (y - 0.14) / 0.72;
    pick(k < 0 || k > 1 ? -1 : Math.min(5, Math.floor(k * 6)));
  });
  canvas?.addEventListener("mouseleave", () => pick(-1));
</script>

<script>
  // Opening: the scroll drives the village's story, the captions, and the final shrink that hands
  // the screen back to the navigation and the hero.
  import { isoCanvas } from "../illustrations/canvas";
  import { STEPS } from "../illustrations/village";

  const saga = document.querySelector<HTMLElement>(".saga");
  const stage = saga?.querySelector<HTMLElement>(".saga-stage");
  const nav = document.querySelector<HTMLElement>(".fg-snav");
  const hero = stage?.querySelector<HTMLElement>(".saga-hero");
  const screenEl = stage?.querySelector<HTMLElement>(".saga-screen");
  const captions = [...(stage?.querySelectorAll<HTMLElement>("[data-step]") ?? [])];
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  // The village plays its story as a machine over the scroll (library/control/erp-village.bp):
  // the page writes the progress, reads the current step from the machine's state, and turns
  // that step's camera shot into a CSS transform.
  const village = isoCanvas(stage?.querySelector<HTMLCanvasElement>('canvas[data-iso="erp-village"]') ?? null);
  const camera = village?.camera;
  // The framing box, projected: the page places a world point on screen with it.
  const FRAME = (() => {
    const box = camera?.fit.box ?? { min: [0, 0, 0], max: [0, 0, 0] };
    const [ax, ay, az] = box.min;
    const [bx, by, bz] = box.max;
    return { minX: ax - by, maxX: bx - ay, minY: (ax + ay) / 2 - bz, maxY: (bx + by) / 2 - az, fill: camera?.fit.fill ?? 1 };
  })();
  // The step without a caption: its subject stays centred.
  const CENTRED = new Set(["unfit"]);
  let progress = 0;
  let step = "intro";
  let writing = false;
  village?.on("state", (_, name) => {
    if (name === step) return;
    step = name;
    // A state reached in a later frame moves the camera then; one reached while the page writes
    // the progress is read by that same update.
    if (!writing) update();
  });

  // Captions come and go through a black-and-white corruption: a 4×4 Bayer mask switches their
  // pixels on (or off) level by level, while whole rows of the text jolt sideways and flicker
  // between ink and dim. No fade: every pixel is on or off.
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
  const masks = Array.from({ length: 17 }, (_, level) => {
    let d = "";
    BAYER.forEach((v, i) => {
      if (v < level) d += `M${(i % 4) * 4} ${Math.floor(i / 4) * 4}h4v4h-4z`;
    });
    return `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' shape-rendering='crispEdges'><path d='${d || "M0 0"}' fill='${d ? "#000" : "none"}'/></svg>`)}")`;
  });
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");
  const shown = new WeakMap<HTMLElement, boolean>();
  const runs = new WeakMap<HTMLElement, number>();
  const timers = new WeakMap<HTMLElement, number>();
  function glitch(el: HTMLElement, on: boolean) {
    const was = shown.get(el);
    if (was === on) return;
    shown.set(el, on);
    cancelAnimationFrame(runs.get(el) ?? 0);
    clearTimeout(timers.get(el));
    // First call for a caption that is already in the right state: nothing to play.
    if (was === undefined && el.hidden === !on) return;
    const clear = () => {
      el.style.maskImage = el.style.webkitMaskImage = "";
      el.style.transform = "";
      el.classList.remove("glitch-dim");
    };
    if (still.matches) {
      el.hidden = !on;
      clear();
      return;
    }
    el.hidden = false;
    const start = performance.now();
    const dur = on ? 520 : 300;
    const step = (now: number) => {
      const k = Math.min(1, (now - start) / dur);
      const level = Math.round((on ? k : 1 - k) * 16);
      const m = masks[level]!;
      el.style.maskImage = el.style.webkitMaskImage = m;
      const jolt = k < 1 && Math.random() < 0.55 ? Math.round((Math.random() - 0.5) * 3) * 6 : 0;
      el.style.transform = jolt ? `translateX(${jolt}px)` : "";
      el.classList.toggle("glitch-dim", k < 1 && Math.random() < 0.35);
      if (k < 1) runs.set(el, requestAnimationFrame(step));
      else {
        clear();
        el.hidden = !on;
      }
    };
    runs.set(el, requestAnimationFrame(step));
    // Frames can be throttled (a background tab): the end state is applied regardless.
    timers.set(
      el,
      window.setTimeout(() => {
        cancelAnimationFrame(runs.get(el) ?? 0);
        clear();
        el.hidden = !on;
      }, dur + 60),
    );
  }

  // The final band of village takes what the hero and the users strip leave of the screen, so
  // nothing is left empty under them, within sensible bounds.
  const bandFor = (h: number, top: number) => {
    const content = [...(hero?.children ?? [])].reduce((sum, el) => sum + (el as HTMLElement).offsetHeight, 0);
    const room = h - top - content;
    // The room the hero and its strip leave, within a floor and a ceiling for very short or tall
    // screens.
    // Two thirds of that, so the hero's text reads well under it; the hero body takes the rest.
    return Math.round(Math.min(h * 0.66, Math.max(h * 0.28, room)) * 0.67);
  };

  let tail = 0;
  const layout = () => {
    if (!stage || !hero) return;
    const top = nav?.offsetHeight ?? 60;
    const band = bandFor(window.innerHeight, top);
    const r = hero.getBoundingClientRect();
    // What the band and the hero leave of the screen: the next section rises under the stage by
    // that much, and the stage's bottom opens onto it as the burn closes. No empty strip.
    const content = [...hero.children].reduce((sum, el) => sum + (el as HTMLElement).offsetHeight, 0);
    tail = Math.max(0, window.innerHeight - top - band - content);
    stage.style.setProperty("--top", `${top}px`);
    stage.style.setProperty("--band", `${band}px`);
    saga?.style.setProperty("--tail", `${tail}px`);
    stage.style.setProperty("--side", `${Math.max(0, r.left)}px`);
  };

  const update = () => {
    if (!saga || !stage) return;
    const r = saga.getBoundingClientRect();
    const p = clamp(-r.top / Math.max(1, r.height - window.innerHeight));
    progress = p;
    writing = true;
    village?.set("progress", p);
    writing = false;
    for (const c of captions) {
      const range = STEPS[c.dataset.step as keyof typeof STEPS];
      glitch(c, Boolean(range && p >= range[0] && p < range[1]));
    }
    // Camera: look at the step's focus, the point placed a little right of centre, clear of the
    // caption. The transform eases between steps (CSS transition).
    const { at, zoom } = camera?.shots?.[step] ?? { at: [0, 0, 0], zoom: 1 };
    const centre = CENTRED.has(step);
    const cw = stage.clientWidth;
    const ch = stage.clientHeight;
    const bw = FRAME.maxX - FRAME.minX;
    const bh = FRAME.maxY - FRAME.minY;
    const u = Math.min((cw * FRAME.fill) / bw, (ch * FRAME.fill) / bh);
    const sx = cw / 2 + ((at[0] - at[1]) - (FRAME.minX + FRAME.maxX) / 2) * u;
    const sy = ch / 2 + ((at[0] + at[1]) / 2 - at[2] - (FRAME.minY + FRAME.maxY) / 2) * u;
    // With the origin at the top left, a point (sx, sy) lands at (sx·z + tx, sy·z + ty). The focus
    // sits right of centre, clear of the caption; at the end it is the centre of the final band.
    const top = nav?.offsetHeight ?? 60;
    const band = bandFor(ch, top);
    const ending = step === "out";
    // Where the subject goes: across from the step's caption, so the text never sits on it.
    const pos = captions.find((c) => c.dataset.step === step)?.dataset.pos ?? "none";
    const AIM: Record<string, [number, number]> = {
      tl: [0.64, 0.58],
      bl: [0.64, 0.4],
      tr: [0.36, 0.58],
      br: [0.36, 0.4],
      top: [0.5, 0.6],
    };
    // No caption (the fire): the subject stays centred, so the move to the final band is straight.
    const [ax, ay] = centre ? [0.5, 0.55] : (AIM[pos] ?? [0.5, 0.5]);
    const gx = ending ? cw / 2 : cw * ax;
    const gy = ending ? top + band / 2 : ch * ay;
    const tx = Math.round(gx - sx * zoom);
    const ty = Math.round(gy - sy * zoom);
    const cam = stage.querySelector<HTMLElement>(".saga-cam");
    if (cam) cam.style.transform = zoom === 1 && !ending ? "" : `translate(${tx}px, ${ty}px) scale(${zoom})`;
    // The close ends exactly where the opening ends: no dead scroll before the page goes on.
    const s = clamp((p - STEPS.out[0]) / (STEPS.out[1] - STEPS.out[0]));
    stage.style.setProperty("--s", s.toFixed(4));
    stage.classList.toggle("is-out", s > 0.98);
    if (hero && screenEl) {
      // The village burns away from every side at once: a rectangle of fire closes from the
      // whole screen onto the final band. Inside it the village is whole; across its edge, a
      // two-ring dithered fringe; outside, the page (the hero below, never dithered).
      const k = clamp((s - 0.3) / 0.7);
      const side = parseFloat(stage.style.getPropertyValue("--side")) || 0;
      const target = { l: side, t: top, r: cw - side, b: top + band };
      const lerp = (a: number, b2: number) => Math.round(a + (b2 - a) * k);
      burnRect = k > 0 && k < 1 ? { l: lerp(0, target.l), t: lerp(0, target.t), r: lerp(cw, target.r), b: lerp(ch, target.b), k } : null;
      hero.style.visibility = k > 0 ? "visible" : "";
      // A clip, not a mask image: an inset is applied in the same frame, on the compositor. A
      // mask rebuilt as an SVG data URL on every scroll had to be decoded (asynchronously) and
      // rasterised again each time: the village flickered and the frame rate dropped.
      // While the opening reveal runs, its circle owns the clip.
      if (k <= 0) {
        if (!revealing) screenEl.style.clipPath = "";
      }
      else {
        const R = k >= 1 ? target : burnRect!;
        screenEl.style.clipPath = `inset(${R.t}px ${cw - R.r}px ${ch - R.b}px ${R.l}px)`;
      }
      paintBurn(performance.now());
      const open = Math.round(tail * k);
      stage.style.clipPath = open > 0 ? `inset(0 0 ${open}px 0)` : "";
    }
    // The table of contents leaves as soon as the view starts to close.
    stage.classList.toggle("is-closing", s > 0.01);
    // Chapters unlock as the story reaches them.
    const order = Object.keys(STEPS);
    const reached = order.indexOf(step);
    for (const b of tocButtons) {
      b.classList.toggle("is-now", b.dataset.goto === step);
      const li = b.parentElement;
      if (li) li.hidden = order.indexOf(b.dataset.goto ?? "") > reached;
    }
    stage.classList.toggle("is-live", s < 0.02);
    nav?.classList.toggle("nav-away", s < 0.5 && r.bottom > window.innerHeight);
  };

  // Table of contents: the current chapter lights up; a click jumps to the start of a chapter.
  const tocButtons = [...(stage?.querySelectorAll<HTMLButtonElement>("[data-goto]") ?? [])];
  const stepStart = (name: string) => {
    const range = STEPS[name as keyof typeof STEPS];
    if (!saga || !range) return 0;
    return saga.offsetTop + (range[0] + 0.005) * (saga.offsetHeight - window.innerHeight);
  };
  for (const b of tocButtons) b.addEventListener("click", () => window.scrollTo({ top: stepStart(b.dataset.goto ?? ""), behavior: "auto" }));

  // Skip: straight to the end of the story, where the page hands over to the hero.
  stage?.querySelector(".saga-skip")?.addEventListener("click", () => {
    if (!saga) return;
    window.scrollTo({ top: saga.offsetTop + saga.offsetHeight - window.innerHeight, behavior: "auto" });
  });

  // The burn front's embers: ragged pixels along the line, white hot, ember, red, and sparks
  // flying up from it. Drawn only while the front moves.
  let burnRect: { l: number; t: number; r: number; b: number; k: number } | null = null;
  const burnEl = stage?.querySelector<HTMLCanvasElement>(".saga-burn");
  const burnCtx = burnEl?.getContext("2d");
  const burnTone = (name: string, fallback: string) =>
    getComputedStyle(stage ?? document.body).getPropertyValue(name).trim() || fallback;
  // The fringe of the burning edge: two rings of 16 px, dithered by a 4×4 Bayer matrix of 4 px
  // cells, the outer ring mostly eaten (5 of 16 cells left), the inner one mostly whole (11 of
  // 16). Painted in the page's background over the village, through two cached patterns.
  const fringe = new Map<number, CanvasPattern | null>();
  const eaten = (level: number) => {
    if (!burnCtx) return null;
    const known = fringe.get(level);
    if (known !== undefined) return known;
    const tile = document.createElement("canvas");
    tile.width = tile.height = 16;
    const t2 = tile.getContext("2d");
    if (!t2) return null;
    t2.fillStyle = burnTone("--bg", "#0a0a0a");
    // Cells at or above `level` are the ones the burn has eaten.
    BAYER.forEach((v, i) => {
      if (v >= level) t2.fillRect((i % 4) * 4, Math.floor(i / 4) * 4, 4, 4);
    });
    const pattern = burnCtx.createPattern(tile, "repeat");
    fringe.set(level, pattern);
    return pattern;
  };
  const ring = (R: { l: number; t: number; r: number; b: number }, o: number, F: number) => {
    if (!burnCtx) return;
    const l = R.l + o;
    const t = R.t + o;
    const r = R.r - o;
    const b = R.b - o;
    burnCtx.fillRect(l, t, r - l, F);
    burnCtx.fillRect(l, b - F, r - l, F);
    burnCtx.fillRect(l, t + F, F, Math.max(0, b - t - 2 * F));
    burnCtx.fillRect(r - F, t + F, F, Math.max(0, b - t - 2 * F));
  };
  let painted = false;
  let colours: string[] | undefined;
  /** Paints the fringe and the embers for the current front, in the frame that moved it. */
  function paintBurn(now: number) {
    if (!burnEl || !burnCtx) return;
    if (!burnRect) {
      if (revealing) return;
      if (painted) burnCtx.clearRect(0, 0, burnEl.width, burnEl.height);
      painted = false;
      return;
    }
    // Sized only when the stage changes size: assigning `width` reallocates the canvas.
    if (burnEl.width !== burnEl.clientWidth || burnEl.height !== burnEl.clientHeight) {
      burnEl.width = burnEl.clientWidth;
      burnEl.height = burnEl.clientHeight;
    }
    burnCtx.clearRect(0, 0, burnEl.width, burnEl.height);
    painted = true;
    const outer = eaten(5);
    const inner = eaten(11);
    if (outer) {
      burnCtx.fillStyle = outer;
      ring(burnRect, 0, 16);
    }
    if (inner) {
      burnCtx.fillStyle = inner;
      ring(burnRect, 16, 16);
    }
    colours ??= [burnTone("--ink", "#ededed"), burnTone("--accent", "#ff4f1f"), burnTone("--danger", "#ff6b81")];
    const P = 4;
    // A slow tick: each ember keeps its place for a while, so the edge glows rather than fizzes.
    const tick = Math.floor(now / 180);
    const { l, t, r, b, k } = burnRect;
    // The embers thin out over the whole second half of the close: the fire dies down gently.
    // It catches over the first fifth of the close and dies down over the second half.
    const q = Math.min(1, Math.max(0, (1 - k) / 0.5));
    const a = Math.min(1, Math.max(0, k / 0.2));
    const life = q * q * (3 - 2 * q) * (a * a * (3 - 2 * a));
    const rnd = (a: number, b2: number, c: number) => {
      let h = (Math.imul(a | 0, 374761393) + Math.imul(b2 | 0, 668265263) + Math.imul(c | 0, 1274126177)) | 0;
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
    };
    // Each edge: walk along it, scatter pixels across it (white at the burn, ember, then red
    // inwards), and now and then a spark thrown outwards.
    const edges: [number, number, number, number, number, number][] = [
      // x0, y0, length, along x (1) or y (0), outward normal x, outward normal y
      [l, t, r - l, 1, 0, -1],
      [l, b, r - l, 1, 0, 1],
      [l, t, b - t, 0, -1, 0],
      [r, t, b - t, 0, 1, 0],
    ];
    // One path per colour, filled once each: thousands of fillRect calls, each switching the
    // fill style, cost more than the rest of the frame.
    const paths = [new Path2D(), new Path2D(), new Path2D()];
    for (const [x0, y0, len, ax, nx, ny] of edges) {
      for (let u = 0; u < len; u += P) {
        const n = Math.sin(u * 0.05 + now * 0.0012) * 3 + Math.sin(u * 0.017 - now * 0.0006) * 5;
        const bx = x0 + (ax ? u : 0);
        const by = y0 + (ax ? 0 : u);
        for (let d = -2; d < 5; d++) {
          if (rnd(u + x0 + y0, d, tick) > (0.5 - d * 0.07) * life) continue;
          const off = 24 - n - d * P;
          paths[d < 0 ? 0 : d < 2 ? 1 : 2]!.rect(Math.round((bx - nx * off) / P) * P, Math.round((by - ny * off) / P) * P, P, P);
        }
        if (rnd(u + x0, y0 + 7, tick) < 0.025 * life) {
          const fly = 6 + rnd(u, 3, tick) * 40;
          paths[1 + Math.floor(rnd(u, 5, tick) * 2)]!.rect(Math.round((bx + nx * fly) / P) * P, Math.round((by + ny * fly) / P) * P, P - 1, P - 1);
        }
      }
    }
    paths.forEach((path, i) => {
      burnCtx.fillStyle = colours![i]!;
      burnCtx.fill(path);
    });
  }
  // While the front stands still, its embers keep glowing: a repaint per frame, only then.
  const burn = (now: number) => {
    requestAnimationFrame(burn);
    if (burnRect) paintBurn(now);
  };
  requestAnimationFrame(burn);

  // The opening reveal: on load, the village spreads from the centre of the screen through the
  // same corruption as the closing burn, but without the fire: the fringe dithered in the page's
  // background, and embers in white, grey and dark grey only. The front is not a circle: it
  // bulges ahead in some places and lags in others, its lobes drifting slowly, and its fringe
  // widens as it nears the edges of the screen.
  let revealing = false;
  const lobes = Array.from({ length: 4 }, () => Math.random() * Math.PI * 2);
  /** How far ahead (+1) or behind (−1) the front is at angle `th`. */
  const lobe = (th: number, now: number) =>
    (Math.sin(th * 3 + lobes[0]! + now * 0.0004) * 0.55 +
      Math.sin(th * 5 + lobes[1]! - now * 0.0007) * 0.3 +
      Math.sin(th * 9 + lobes[2]! + now * 0.001) * 0.2 +
      Math.sin(th * 17 + lobes[3]!) * 0.1) /
    1.15;
  const AMP = 0.18;
  const SIDES = 144;
  /** The front's outline at radius `R`: one point per angle, `inset` pixels inside it. */
  const outline = (cx: number, cy: number, R: number, now: number, inset = 0) => {
    const pts: [number, number][] = [];
    for (let i = 0; i < SIDES; i++) {
      const th = (i / SIDES) * Math.PI * 2;
      const r = Math.max(0, R * (1 + AMP * lobe(th, now)) - inset);
      pts.push([cx + Math.cos(th) * r, cy + Math.sin(th) * r]);
    }
    return pts;
  };
  function paintReveal(R: number, k: number, W: number, now: number) {
    if (!burnEl || !burnCtx || !stage) return;
    if (burnEl.width !== burnEl.clientWidth || burnEl.height !== burnEl.clientHeight) {
      burnEl.width = burnEl.clientWidth;
      burnEl.height = burnEl.clientHeight;
    }
    burnCtx.clearRect(0, 0, burnEl.width, burnEl.height);
    painted = true;
    const cx = stage.clientWidth / 2;
    const cy = stage.clientHeight / 2;
    // The fringe: two rings of `W` px inside the front, the outer mostly eaten.
    const band = (i0: number, i1: number) => {
      const path = new Path2D();
      for (const inset of [i0, i1]) {
        outline(cx, cy, R, now, inset).forEach(([x, y], i) => (i ? path.lineTo(x, y) : path.moveTo(x, y)));
        path.closePath();
      }
      return path;
    };
    const outer = eaten(5);
    const inner = eaten(11);
    if (outer) {
      burnCtx.fillStyle = outer;
      burnCtx.fill(band(0, W), "evenodd");
    }
    if (inner) {
      burnCtx.fillStyle = inner;
      burnCtx.fill(band(W, 2 * W), "evenodd");
    }
    const greys = [burnTone("--ink", "#ededed"), burnTone("--ink-muted", "#a0a0a0"), burnTone("--ink-dim", "#5a5a5a")];
    const P = 4;
    const tick = Math.floor(now / 120);
    // Catches at once, dies down over the last third.
    const q = Math.min(1, Math.max(0, (1 - k) / 0.35));
    const life = q * q * (3 - 2 * q);
    const rnd = (a: number, b2: number, c: number) => {
      let h = (Math.imul(a | 0, 374761393) + Math.imul(b2 | 0, 668265263) + Math.imul(c | 0, 1274126177)) | 0;
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
    };
    const paths = [new Path2D(), new Path2D(), new Path2D()];
    // Walk the front a pixel cell at a time: white at the front, grey, then dark grey inwards,
    // spread over the fringe's width, and now and then a speck thrown outwards, ahead of it.
    const spread = W / 16;
    const steps = Math.max(24, Math.ceil((Math.PI * 2 * R * (1 + AMP)) / P));
    for (let i = 0; i < steps; i++) {
      const th = (i / steps) * Math.PI * 2;
      const nx = Math.cos(th);
      const ny = Math.sin(th);
      const edge = R * (1 + AMP * lobe(th, now));
      const n = (Math.sin(th * 9 + now * 0.002) * 3 + Math.sin(th * 23 - now * 0.0011) * 4) * spread;
      for (let d = -2; d < 5; d++) {
        if (rnd(i, d, tick) > (0.5 - d * 0.07) * life) continue;
        const rr = edge - W * 1.5 + n - d * P * spread;
        paths[d < 0 ? 0 : d < 2 ? 1 : 2]!.rect(Math.round((cx + nx * rr) / P) * P, Math.round((cy + ny * rr) / P) * P, P, P);
      }
      if (rnd(i, 7, tick) < 0.03 * life) {
        const fly = (6 + rnd(i, 3, tick) * 40) * spread;
        paths[1 + Math.floor(rnd(i, 5, tick) * 2)]!.rect(Math.round((cx + nx * (edge + fly)) / P) * P, Math.round((cy + ny * (edge + fly)) / P) * P, P - 1, P - 1);
      }
    }
    paths.forEach((path, i) => {
      burnCtx.fillStyle = greys[i]!;
      burnCtx.fill(path);
    });
  }
  /** Plays the reveal once, only from the top of the story and never under reduced motion. */
  function reveal() {
    const el = screenEl;
    const st = stage;
    if (!el || !st || still.matches || progress > 0.01) return;
    revealing = true;
    const DUR = 1900;
    const DELAY = 150;
    let start = -1;
    // Hidden at once, before the first frame paints the village whole.
    el.style.clipPath = "circle(0px at 50% 50%)";
    const end = () => {
      revealing = false;
      el.style.clipPath = "";
      burnCtx?.clearRect(0, 0, burnEl?.width ?? 0, burnEl?.height ?? 0);
      painted = false;
      update();
    };
    const frame = (now: number) => {
      if (!revealing) return;
      // Scrolling to the end of the story cuts the reveal short.
      if (progress > STEPS.out[0]) return end();
      if (start < 0) start = now + DELAY;
      const t = Math.min(1, Math.max(0, (now - start) / DUR));
      // Slow at the start, fast across the screen, slowing again at the corners.
      const k = t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2;
      const cw = st.clientWidth;
      const ch = st.clientHeight;
      // The fringe: 12 px a ring at the centre, 48 px by the edges, in whole pixel cells.
      const W = Math.round((12 + 36 * k) / 4) * 4;
      // Far enough that even the most lagging lobe clears the corners, fringe and embers with it.
      const R = Math.round((k * (Math.hypot(cw, ch) / 2 + 3 * W + 48)) / (1 - AMP));
      const pts = outline(cw / 2, ch / 2, R, now);
      el.style.clipPath = `polygon(${pts.map(([x, y]) => `${x.toFixed(1)}px ${y.toFixed(1)}px`).join(",")})`;
      if (R > 0) paintReveal(R, t, W, now);
      if (t >= 1) return end();
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    // A throttled tab still ends on the whole village.
    window.setTimeout(() => revealing && end(), DELAY + DUR + 1500);
  }
  layout();
  update();
  // From here the script decides where the nav is (see `body.home:not(.saga-ready)`).
  document.body.classList.add("saga-ready");
  reveal();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", () => {
    layout();
    update();
  });
</script>

<script>
  // Resource legend in step with the highlighted resource; hovering a line picks it.
  import { isoCanvas } from "../illustrations/canvas";

  const res = isoCanvas(document.getElementById("res-canvas"));
  const rows = document.querySelectorAll<HTMLElement>("[data-res]");
  res?.onActive((active) => {
    for (const li of rows) li.classList.toggle("on", Number(li.dataset.res) === active);
  });
  // Moving from one row to the next selects the next at once; only leaving the list hands the
  // highlight back to the cycle, so nothing jumps in between.
  for (const li of rows) li.addEventListener("mouseenter", () => res?.select(Number(li.dataset.res)));
  rows[0]?.parentElement?.addEventListener("mouseleave", () => res?.select(-1));
</script>

<script>
  // Develop: the line stays pinned while its track scrolls by; the scroll moves the package, and
  // the stop it has reached (the state of the scene's machine) lights up.
  import { isoCanvas } from "../illustrations/canvas";

  const track = document.querySelector<HTMLElement>(".line-track");
  const stopEls = [...document.querySelectorAll<HTMLElement>("[data-stop]")];
  const line = isoCanvas(document.getElementById("line-canvas"));
  const STOPS = ["local", "preview", "production"];
  line?.on("state", (_, name) => {
    const at = STOPS.indexOf(name);
    for (const li of stopEls) li.classList.toggle("on", Number(li.dataset.stop) === at);
  });
  const onScroll = () => {
    if (!track) return;
    const r = track.getBoundingClientRect();
    const pin = track.querySelector<HTMLElement>(".line-pin");
    const run = Math.max(1, r.height - (pin?.offsetHeight ?? 0));
    const top = pin ? parseFloat(getComputedStyle(pin).top) || 0 : 0;
    const p = Math.min(1, Math.max(0, (top - r.top) / run));
    line?.set("progress", p);
  };
  const placePin = () => {
    const pin = track?.querySelector<HTMLElement>(".line-pin");
    if (!pin) return;
    // Under the navigation if it all fits; else bottom-aligned, but never so high that the
    // drawing slides under the navigation (the hosting head then runs off the bottom instead).
    const head = pin.querySelector<HTMLElement>(".fg-sec-head")?.offsetHeight ?? 0;
    const top = Math.max(Math.min(60, window.innerHeight - pin.offsetHeight), 60 - head);
    pin.style.setProperty("--pin-top", `${top}px`);
    onScroll();
  };
  placePin();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", placePin);
</script>

