---
import {
  AnvilIcon,
  ApiIcon,
  BoltIcon,
  BookOpen01Icon,
  BrowserIcon,
  CheckmarkSquare01Icon,
  CloudIcon,
  CommandLineIcon,
  DatabaseIcon,
  DeployIcon,
  GitBranchIcon,
  GithubIcon,
  Key01Icon,
  LockIcon,
  LogIcon,
  McpIcon,
  MinusSignIcon,
  PlusSignIcon,
  RollbackIcon,
  Settings01Icon,
  Shield01Icon,
} from "@forgeron/icons";
import {
  Button,
  Chip,
  Command,
  Icon,
  Led,
  Link,
  Logo,
  PixelText,
  Tag,
  Title,
} from "@forgeron/ui";
import Footer from "../components/Footer.astro";
import SectionHead from "../components/SectionHead.astro";
import Site from "../layouts/Site.astro";

/** The public repository (Apache-2.0) and its documentation. */
const GITHUB = "https://github.com/forgeron-sh/monorepo";
const DOCS = "https://github.com/forgeron-sh/monorepo/blob/main/docs/sdk.md";

/** Layers of the exploded stack, bottom (index 0) to top. */
const layers = [
  { i: 0, name: "Data", text: "Tables, and secrets held per person." },
  { i: 1, name: "Runtime", text: "Cloudflare Workers. Hosted by us or by you." },
  { i: 2, name: "Tools", text: "Versioned on every push, previewed before production." },
  { i: 3, name: "Access", text: "Company SSO, teams, permissions per action." },
  { i: 4, name: "Interfaces", text: "MCP, API, web and CLI from one definition." },
];
const left = [4, 2, 0].map((i) => layers[i]!);
const right = [3, 1].map((i) => layers[i]!);

/** The opening's captions, one per step of the story (ranges in `STEPS`, illustrations/village.ts). */
const sagaSteps: { step: string; title: string; pos: "top" | "tl" | "tr" | "bl" | "br" }[] = [
  { step: "intro", title: "Anatomy of a fall.", pos: "tr" },
  { step: "complex", title: "It does everything, all at once, and none of it is simple.", pos: "tl" },
  { step: "unfit", title: "None of it fits the way you work, and every module is billed.", pos: "tr" },
  { step: "excel", title: "So the real work moves to spreadsheets next door.", pos: "tl" },
  { step: "tinker", title: "It tinkers to catch up: custom patches, nailed on wherever it hurts.", pos: "bl" },
  { step: "upgrade", title: "Then every upgrade is a building site, and the patches do not survive it.", pos: "bl" },
  { step: "generic", title: "It goes generic, and every need becomes a gas factory.", pos: "tl" },
  { step: "plug", title: "It plugs into twenty thousand services, give or take.", pos: "bl" },
  { step: "ai", title: "Everyone else has AI. Here, half of it is plugged in, and that half misfires.", pos: "tl" },
  { step: "lockin", title: "And once you are in, you are fenced in: your data has no way out.", pos: "br" },
  { step: "support", title: "Every question it cannot answer becomes one more ticket on the pile.", pos: "br" },
  { step: "boom", title: "Until the whole thing blows.", pos: "bl" },
];

/** The opening's table of contents: a short name per step, in the story's order. */
const sagaToc: { step: string; name: string }[] = [
  { step: "intro", name: "The village" },
  { step: "complex", name: "Complexity" },
  { step: "unfit", name: "Your bank account" },
  { step: "excel", name: "Shadow Excel" },
  { step: "tinker", name: "Custom patches" },
  { step: "upgrade", name: "Upgrades" },
  { step: "generic", name: "Gas factory" },
  { step: "plug", name: "Connectors" },
  { step: "ai", name: "AI" },
  { step: "lockin", name: "Vendor lock-in" },
  { step: "support", name: "Support" },
  { step: "boom", name: "Explosion" },
];

/**
 * Who uses Forgeron, shown in a band before the system section. Real names only: leave the list
 * empty rather than invent one; empty slots render as hatched cells until it is filled.
 */
const users: string[] = [];
const userSlots = 4;

/** A pixel Y on an ember square: the Y Combinator mark, redrawn in the bitmap face, in the page's
 * one orange (`--accent`) with black (`--accent-ink`) on it. */
const ycMark = (() => {
  const y = ["#...#", "#...#", ".#.#.", "..#..", "..#..", "..#..", "..#.."];
  let d = "";
  y.forEach((row, r) => [...row].forEach((c, x) => (d += c === "#" ? `M${x + 2} ${r + 2}h1v1h-1z` : "")));
  return `<svg viewBox="0 0 9 11" shape-rendering="crispEdges" aria-hidden="true"><rect width="9" height="11" style="fill:var(--accent)"/><path style="fill:var(--accent-ink)" d="${d}"/></svg>`;
})();

const proof = [
  { icon: CloudIcon, text: "Cloudflare Workers" },
  { icon: AnvilIcon, text: "Apache-2.0" },
  { icon: LockIcon, text: "Company SSO" },
];

const doors = [
  { name: "MCP", iso: "mcp", icon: McpIcon, text: "Your teams use the tool from Claude, with their own rights." },
  { name: "API", iso: "api", icon: ApiIcon, text: "A REST endpoint per action, for your scripts and other tools." },
  { name: "Web", iso: "web", icon: BrowserIcon, text: "The tool's own web interface, behind your company's SSO." },
  { name: "CLI", iso: "cli", icon: CommandLineIcon, text: "forgeron <tool> <action>, with --json for scripts." },
];

const teams = ["Sales", "Support", "Mgmt"];
const grants = [
  { name: "contacts.read", g: [1, 1, 1] },
  { name: "contacts.update", g: [1, 0, 1] },
  { name: "deals.move", g: [1, 0, 1] },
  { name: "deals.delete", g: [0, 0, 1] },
];

const deployments = [
  { v: "v1.5.0-rc.2", m: "Contacts CSV export", meta: "8dc01b2 · 4 min ago", env: "Preview", led: "warning" as const },
  { v: "v1.4.1", m: "Slimmer contact record", meta: "77c2d1a · yesterday", env: "Production", led: "success" as const },
  { v: "v1.4.0", m: "deals.move action with history", meta: "a41f9e0 · Mon", env: "Production", led: "success" as const },
];

const commands = [
  { cmd: "npx forgeron init --template crm", note: "a tool, its test and its CI" },
  { cmd: "forgeron dev", note: "runs locally, with local D1, KV, R2" },
  { cmd: "forgeron test", note: "builds, then runs Vitest" },
  { cmd: "forgeron deploy", note: "a version per push" },
  { cmd: "forgeron secrets set ODOO_API_KEY", note: "read from the keyboard, never an argument" },
  { cmd: "forgeron rollback --channel production", note: "back to the previous version" },
  { cmd: "forgeron preview close", note: "tears down a merged branch" },
  { cmd: 'forgeron crm contacts search "Durand"', note: "your tool, from the terminal" },
];

const audit = [
  { t: "14:09", who: "sophie@", what: "deals.move", tag: "write" },
  { t: "14:12", who: "marc@", what: "contacts.read", tag: "read" },
  { t: "14:16", who: "ci", what: "deploy v1.4.1", tag: "deploy" },
  { t: "14:21", who: "sophie@", what: "contacts.update", tag: "write" },
];

const hosting = [
  { k: "Cloudflare account", cloud: "Ours", self: "Yours" },
  { k: "A tool is", cloud: "Workers for Platforms", self: "A classic Worker" },
  { k: "Tool resources", cloud: "Dedicated D1, KV, R2", self: "Dedicated D1, KV, R2" },
  { k: "Installed by", cloud: "Nothing to install", self: "The forgeron CLI" },
];

const numbers = [
  { n: "1", label: "definition per tool" },
  { n: "4", label: "interfaces served" },
  { n: "1", label: "Worker per tool and environment" },
  { n: "0", label: "servers to manage" },
];

const templates = [
  { n: "01", name: "Lightweight CRM", path: "templates/crm", iso: "blocks", text: "Companies, contacts and leads, usable from Claude." },
  { n: "02", name: "Data hub", path: "templates/inventory", iso: "cube", text: "A business data repository, fed by imports and syncs." },
  { n: "03", name: "Dashboard", path: "templates/dashboard", iso: "bars", text: "A lightweight sales dashboard on top of the CRM." },
];

const faq = [
  {
    q: "What is a tool?",
    a: "A folder with a forgeron.config.ts and one file per action, each with its input and access level. Forgeron serves every action over MCP, a REST API, the web and the CLI.",
  },
  {
    q: "Do I need servers?",
    a: "No. Each tool runs as its own Cloudflare Worker, per environment, with dedicated D1, KV and R2.",
  },
  {
    q: "Can I host it myself?",
    a: "Yes. The same platform installs on your own Cloudflare account with the forgeron CLI. Or let us host it.",
  },
  {
    q: "How do my teams sign in?",
    a: "Through your company's SSO. Access is granted to teams, action by action, and usage is recorded in the audit log.",
  },
  {
    q: "Where do personal API keys go?",
    a: "Each person stores their own secrets, encrypted at rest. The CLI reads values from the keyboard, never from an argument.",
  },
  { q: "Is it open source?", a: "Yes, under the Apache-2.0 license." },
];
const resources = [
  { i: 0, icon: DatabaseIcon, name: "Database", cf: "D1", text: "One database per tool and environment, bound to its Worker." },
  { i: 1, icon: BoltIcon, name: "Cache", cf: "KV", text: "Key-value storage for what the tool reads often." },
  { i: 2, icon: BookOpen01Icon, name: "Files", cf: "R2", text: "One prefix per tool and environment, with size and type limits." },
  { i: 3, icon: LogIcon, name: "Queue", cf: "Queues", text: "Work the tool hands off and runs in the background." },
  { i: 4, icon: Key01Icon, name: "Secrets", cf: "Encrypted", text: "The tool's own, or one per person, encrypted by the platform." },
];
---

<Site
  title="Forgeron — Forge your internal tools"
  description="Write an internal tool once with the Forgeron SDK. Your teams use it from Claude (MCP), the API, the web and the terminal, behind your company's SSO, on Cloudflare Workers. Open source, Apache-2.0."
  bodyClass="home"
>
  <nav class="nav" aria-label="Main navigation">
    <div class="rail">
      <a href="#top" aria-label="Forgeron, home"><Logo /></a>
      <div class="nav-links text-eyebrow">
        <a href="#system">System</a>
        <a href="#doors">Interfaces</a>
        <a href="#develop">Develop</a>
        <a href="#resources">Resources</a>
        <a href="#ship">Ship</a>
        <a href="#govern">Govern</a>
        <a href="#host">Host</a>
      </div>
      <div class="nav-actions">
        <Button href={GITHUB} size="sm"><Icon icon={GithubIcon} size={16} variant="mono" />GitHub</Button>
        <Button href="#start" size="sm" variant="primary" marker>Get started</Button>
      </div>
    </div>
  </nav>

  <main>
    <!-- HERO: banner image, then title and call to action -->
    <section id="top" class="saga">
      <div class="saga-stage">
        <figure class="saga-screen">
          <canvas class="saga-bg" data-shader="field" data-px="4" data-accent="off" aria-hidden="true"></canvas>
          <div class="saga-cam">
            <canvas data-iso="erp-village" data-scale="2" data-unit="any" data-fill="0.98" data-signal="--success" aria-hidden="true"></canvas>
          </div>
          <figcaption class="sr-only">
            An island of absurd machines around an ERP: a slot machine eating your bank account, a CRM wheel throwing
            contacts away, a support tank under pressure. As you scroll, the ERP tinkers, goes generic, plugs into
            everything, explodes, and the village burns.
          </figcaption>
        </figure>
        <canvas class="saga-burn" aria-hidden="true"></canvas>
        <p class="saga-live text-eyebrow"><span class="saga-dot" aria-hidden="true"></span>Live</p>
        <button type="button" class="saga-skip text-eyebrow">Skip intro</button>
        <nav class="saga-toc" aria-label="Chapters">
          <ol>
            {
              sagaToc.map((c, i) => (
                <li hidden={i > 0}>
                  <button type="button" data-goto={c.step}>
                    <span class="saga-toc-n">{String(i + 1).padStart(2, "0")}</span>
                    {c.name}
                  </button>
                </li>
              ))
            }
          </ol>
        </nav>
        <ol class="saga-captions">
          {
            sagaSteps.map((c) => (
              <li data-step={c.step} data-pos={c.pos} hidden={c.step !== "intro"}>
                <Title as="h2" size="h2">{c.title}</Title>
              </li>
            ))
          }
        </ol>
        <div class="saga-hero rail hero-d">
      <div class="hero-d-body">
        <div class="hero-d-left">
          <span class="yc-badge text-eyebrow">
            <span class="yc-mark" set:html={ycMark} />
            Not backed by Y Combinator
          </span>
          <Title as="h1" size="hero">Forge your<br />internal tools.</Title>
          <div class="hero-d-proof">
            <span class="text-eyebrow dim">Built on</span>
            {
              proof.map((p) => (
                <span class="hero-d-chip text-eyebrow">
                  <Icon icon={p.icon} size={24} />
                  {p.text}
                </span>
              ))
            }
          </div>
        </div>
        <div class="hero-d-right">
          <p class="text-lead lead">Write a tool once. Your teams use it from Claude, the API, the web and the terminal.</p>
          <div class="hero-d-cta">
            <Command framed={false}>npx forgeron init</Command>
            <Button href="#start" size="lg" variant="primary" marker>Get started</Button>
          </div>
        </div>
      </div>
      <!-- USED BY: a band of names, in the style of the font site's facts strip, closing the hero -->
    <section class="users" aria-label="Who uses Forgeron">
      <ul class="bento users-row">
        <li class="cell ticks user-lead"><span class="text-eyebrow dim">Forging at</span></li>
        {
          Array.from({ length: userSlots }, (_, i) => users[i]).map((name) =>
            name ? (
              <li class="cell ticks user">
                <span class="user-name">{name}</span>
              </li>
            ) : (
              <li class="cell user user-empty" aria-hidden="true" />
            ),
          )
        }
      </ul>
    </section>
        </div>
      </div>
    </section>

    <!-- 0.1 SYSTEM -->
    <section id="system" class="rail">
      <SectionHead index="/0.1" label="System">
        <Title as="h2" size="h2">One tool,<br />five layers.</Title>
        <p class="sec-lead">Everything a business tool needs, stacked once, so your developers only write the actions.</p>
      </SectionHead>
      <div class="stack">
        <ul class="stack-col">
          {
            left.map((l) => (
              <li data-layer={l.i}>
                <span class="text-eyebrow accent">0{l.i + 1}</span>
                <span class="text-title-3">{l.name}</span>
                <span class="text-small muted">{l.text}</span>
              </li>
            ))
          }
        </ul>
        <div class="stack-art dots-bg">
          <canvas id="stack-canvas" data-iso="stack" data-cycle="2.4" data-scale="2" data-fill="0.58" aria-hidden="true"></canvas>
        </div>
        <ul class="stack-col stack-col-r">
          {
            right.map((l) => (
              <li data-layer={l.i}>
                <span class="text-eyebrow accent">0{l.i + 1}</span>
                <span class="text-title-3">{l.name}</span>
                <span class="text-small muted">{l.text}</span>
              </li>
            ))
          }
          <li class="stack-empty" aria-hidden="true"></li>
        </ul>
      </div>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.1 → /0.2</span><span>[ Interfaces ]</span></div>

    <!-- 0.2 DOORS -->
    <section id="doors" class="rail">
      <SectionHead index="/0.2" label="Interfaces">
        <Title as="h2" size="h2">Pick a door.</Title>
        <p class="sec-lead">The same actions, the same rights, wherever your teams already work.</p>
      </SectionHead>
      <div class="doors">
        {
          doors.map((d, i) => (
            <article class="door ticks">
              <div class="door-art dots-bg">
                <canvas data-iso={d.iso} data-scale="2" data-fill="0.6" aria-hidden="true" />
              </div>
              <div class="door-copy">
                <div class="door-head">
                  <Icon icon={d.icon} size={24} />
                </div>
                <Title as="h3" size="h3">{d.name}</Title>
                <p class="text-small muted">{d.text}</p>
              </div>
              <Button href="#start" size="lg" variant={i === 0 ? "primary" : "secondary"} className="door-btn">
                Explore {d.name}
              </Button>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 0.3 IN PRACTICE (bento) -->
    <section id="interfaces" class="rail">
      <SectionHead index="/0.3" label="In practice">
        <Title as="h2" size="h2">Where your<br />teams already are.</Title>
      </SectionHead>
      <div class="bento">
        <article class="cell ticks c4 r3">
          <div class="corner-r row">
            <Chip active>MCP</Chip><Chip>API</Chip><Chip>Web</Chip><Chip>CLI</Chip>
          </div>
          <div class="art"><canvas data-iso="network" data-scale="2" data-fill="0.58" aria-hidden="true"></canvas></div>
          <div class="copy">
            <h3 class="text-title-3">One definition, four interfaces</h3>
            <p class="text-small muted">Every action is served over MCP, REST, the web and the terminal.</p>
          </div>
        </article>
        <article class="cell ticks c2 r3">
          <div class="art chat dots-bg">
            <div class="msg me text-code">Move the Durand deal to Won.</div>
            <div class="msg tool text-eyebrow">
              <Led tone="accent" /> crm.deals.move
              <span class="dim">write · Sales</span>
            </div>
            <div class="msg text-code muted">Done. Durand → Won, logged in the deal history.</div>
          </div>
          <div class="copy hr">
            <h3 class="text-title-3">From the conversation</h3>
            <p class="text-small muted">Your teams ask; the tool acts, with their rights.</p>
          </div>
        </article>
        <article class="cell ticks c3 r2">
          <div class="art perms">
            <table class="text-eyebrow">
              <thead>
                <tr><th></th>{teams.map((t) => <th>{t}</th>)}</tr>
              </thead>
              <tbody>
                {
                  grants.map((r) => (
                    <tr>
                      <td>{r.name}</td>
                      {r.g.map((v) => (
                        <td>
                          <span class={v ? "px on" : "px"} />
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="copy hr"><h3 class="text-title-3">Teams × actions, nothing more</h3></div>
        </article>
        <article class="cell ticks c3 r2">
          <div class="corner-r row text-bit"><Led tone="success" /> prod <Led tone="warning" /> preview</div>
          <div class="art"><canvas data-iso="blocks" data-scale="2" data-fill="0.7" aria-hidden="true"></canvas></div>
          <div class="copy hr"><h3 class="text-title-3">Preview, then production</h3></div>
        </article>
      </div>
    </section>

    <div class="rail spacer text-eyebrow dim"><span>/0.3 → /0.4</span><span>[ Develop ]</span></div>

    <!-- 0.4 DEVELOP -->
    <section id="develop" class="rail">
      <SectionHead index="/0.4" label="Develop">
        <Title as="h2" size="h2">Write actions,<br />not plumbing.</Title>
      </SectionHead>
      <div class="feat">
        <div class="feat-copy">
          <p class="text-lead lead">
            A tool is a <code>forgeron.config.ts</code> and one file per action: its input, its access level, its run. Interfaces, access and hosting come with it.
          </p>
          <Link href={DOCS}>Read the SDK →</Link>
          <div class="code">
            <div class="code-head">
              <span class="text-eyebrow dim">crm/actions/deals/move.ts</span>
              <Tag>crm · v1.4.0</Tag>
            </div>
            <pre><code><span class="k">import</span> {"{"} action, z {"}"} <span class="k">from</span> <span class="s">"@forgeron/sdk"</span>;

<span class="k">export default</span> action({"{"}
  description: <span class="s">"Moves a lead to a new stage."</span>,
  access: <span class="s">"write"</span>,
  input: z.object({"{"} id: z.string(), stage: z.enum([<span class="s">"won"</span>, <span class="s">"lost"</span>]) {"}"}),
  cli: {"{"} args: [<span class="s">"id"</span>, <span class="s">"stage"</span>] {"}"},
  <span class="k">async</span> run(ctx) {"{"}
    <span class="c">/* … */</span>
  {"}"},
{"}"});</code></pre>
          </div>
        </div>
        <div class="feat-art dots-bg"><canvas data-iso="module" data-scale="2" data-fill="0.54" aria-hidden="true"></canvas></div>
      </div>
      <ul class="feat-list">
        <li><Icon icon={CommandLineIcon} /><span class="text-title-3">Local first</span><span class="text-small muted"><code>forgeron dev</code> runs the tool on your machine, with local D1, KV and R2.</span></li>
        <li><Icon icon={Shield01Icon} /><span class="text-title-3">Typed inputs</span><span class="text-small muted">Each action declares its input with Zod; the same schema drives MCP, the API and the CLI options.</span></li>
        <li><Icon icon={CheckmarkSquare01Icon} /><span class="text-title-3">Tested in CI</span><span class="text-small muted"><code>forgeron test</code> builds the tool, then runs Vitest against the real Worker.</span></li>
      </ul>
    </section>

    <!-- 0.5 RESOURCES -->
    <section id="resources" class="rail">
      <SectionHead index="/0.5" label="Resources">
        <Title as="h2" size="h2">Declared,<br />or absent.</Title>
        <p class="sec-lead">
          A tool lists everything it asks of the platform, like an app's permissions. What is not declared does not
          exist at runtime.
        </p>
      </SectionHead>
      <div class="res">
        <div class="res-art dots-bg">
          <canvas id="res-canvas" data-iso="resources" data-cycle="1.6" data-scale="2" data-fill="0.7" aria-hidden="true"></canvas>
        </div>
        <ul class="res-list">
          {
            resources.map((r) => (
              <li data-res={r.i}>
                <Icon icon={r.icon} />
                <div>
                  <span class="text-title-3">{r.name}</span> <span class="text-eyebrow dim">{r.cf}</span>
                  <p class="text-small muted">{r.text}</p>
                </div>
              </li>
            ))
          }
          <li class="res-ghost">
            <Icon icon={Shield01Icon} />
            <div>
              <span class="text-title-3">Not declared</span> <span class="text-eyebrow dim">Ghost</span>
              <p class="text-small muted">Absent: <code>ctx.db</code> without a database, <code>ctx.fetch</code> refuses unlisted hosts.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="res-code">
        <div class="code">
          <div class="code-head">
            <span class="text-eyebrow dim">forgeron.config.ts · resources</span>
            <Tag>Declaration</Tag>
          </div>
          <pre><code>resources: {"{"}
  db: database({"{"} engine: <span class="s">"d1"</span>, why: <span class="s">"Companies, contacts and leads"</span> {"}"}),
  files: bucket({"{"} maxSize: <span class="s">"25MB"</span>, why: <span class="s">"Lead attachments"</span> {"}"}),
  cache: kv(),
  userSecrets: {"{"}
    ODOO_API_KEY: {"{"} label: <span class="s">"Odoo API key"</span>, why: <span class="s">"Read your Odoo tickets"</span> {"}"},
  {"}"},
  network: {"{"} allow: [<span class="s">"api.hubspot.com"</span>] {"}"},
{"}"}</code></pre>
        </div>
        <div class="code">
          <div class="code-head">
            <span class="text-eyebrow dim">What the admin sees</span>
            <Tag>Console · admin MCP</Tag>
          </div>
