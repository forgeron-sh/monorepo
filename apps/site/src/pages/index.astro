---
import { Badge, Button, EnvTag, Label, Logo } from "@forgeron/ui";
import { CodeCard } from "../components/CodeCard";
import { ExampleTabs } from "../components/ExampleTabs";
import Footer from "../components/Footer.astro";
import Frame from "../components/Frame.astro";
import Header from "../components/Header.astro";
import Base from "../layouts/Base.astro";

const templates = [
  { path: "templates/crm", name: "CRM léger", text: "Sociétés, contacts et pistes, utilisables depuis Claude." },
  {
    path: "templates/odoo-gateway",
    name: "Passerelle Odoo",
    text: "Interrogez Odoo depuis Claude avec la clé d'API de chaque personne.",
  },
  {
    path: "templates/inventaire",
    name: "Centre de données",
    text: "Un référentiel de données métier, alimenté par imports et synchronisations.",
  },
  { path: "templates/pilotage", name: "Tableau de bord", text: "Un tableau de bord commercial léger, au-dessus du CRM." },
];

const deployments = [
  { version: "v1.5.0-rc.2", message: "Export CSV des contacts", meta: "8dc01b2 · il y a 4 min", env: "preview", state: "warning" },
  { version: "v1.4.1", message: "Fiche contact allégée", meta: "77c2d1a · hier", env: "pilot", state: "success" },
  { version: "v1.4.0", message: "Action deals.move avec historique", meta: "a41f9e0 · lun.", env: "production", state: "success" },
] as const;

const roles = ["Commerciaux", "Support", "Direction"];
const permissions = [
  { name: "contacts.read", kind: "Lecture", grants: [true, true, true] },
  { name: "contacts.update", kind: "Écriture", grants: [true, false, true] },
  { name: "deals.delete", kind: "Suppression", grants: [false, false, true] },
];

const viewCode = [
  'import { defineView, useAction } from "forgeron/react";',
  "",
  "export default defineView({",
  '  name: "pipeline",',
  "  render() {",
  '    const deals = useAction("crm.deals.list");',
  "    return <Kanban columns={deals.byStage()} />;",
  "  },",
  "});",
];
---

<Base
  title="Forgeron — forgez vos internal tools"
  description="Forgez vos internal tools une fois, utilisez-les depuis Claude, l'API, le Web et le terminal."
>
  <Header />

  <main>
    <section id="top" class="wrap hero">
      <Badge mono dot>Open source · Propulsé par Cloudflare Workers</Badge>
      <h1>Forgez vos internal tools.</h1>
      <p>
        Écrivez un outil une fois avec le SDK Forgeron. Il est versionné, déployé sur Cloudflare et exposé en MCP,
        API, Web et CLI, derrière le SSO de votre entreprise.
      </p>
      <div class="hero-actions">
        <Button href="#commencer" variant="primary" size="lg">Commencer gratuitement</Button>
        <span class="command text-code"><span class="muted">$</span>npx forgeron init</span>
      </div>
    </section>

    <section id="produit" class="wrap" style="padding-bottom: 96px;">
      <ExampleTabs client:visible />
    </section>

    <section class="wrap section stack-3" style="gap: 48px;">
      <div class="section-head center stack-3">
        <Label>Pourquoi Forgeron</Label>
        <h2 class="display-section">Vos équipes parlent à Claude. Elles n'ont plus besoin d'un ERP.</h2>
        <p class="lead">
          Quand l'interface devient la conversation, ce qui compte, c'est que les données et les actions
          fonctionnent. Pas la taille de la suite logicielle derrière.
        </p>
      </div>
      <Frame class="compare">
        <div>
          <Label>Aujourd'hui</Label>
          <h3 class="muted">Une suite géante, payée au module.</h3>
          <ul class="muted">
            <li><span class="text-code-inline" aria-hidden="true">—</span>Des licences pour des modules que personne n'ouvre</li>
            <li><span class="text-code-inline" aria-hidden="true">—</span>Une interface imposée, lourde à adapter</li>
            <li><span class="text-code-inline" aria-hidden="true">—</span>Des intégrations sur mesure à chaque besoin</li>
            <li><span class="text-code-inline" aria-hidden="true">—</span>Aucun accès propre depuis un assistant IA</li>
          </ul>
        </div>
        <div class="invert">
          <Label>Avec Forgeron</Label>
          <h3>Des outils légers, forgés sur mesure.</h3>
          <ul>
            <li><span class="check check-inv" aria-hidden="true"></span>Seulement les outils dont vous avez besoin : CRM, fiches contact, données</li>
            <li><span class="check check-inv" aria-hidden="true"></span>Utilisables depuis Claude, une API, le terminal ou une interface web</li>
            <li><span class="check check-inv" aria-hidden="true"></span>Modifiables par vos développeurs, versionnés à chaque push</li>
            <li><span class="check check-inv" aria-hidden="true"></span>Hébergés chez nous ou chez vous, en open source</li>
          </ul>
        </div>
      </Frame>
    </section>

    <section class="wrap section stack-3" style="gap: 40px;">
      <div class="section-head">
        <Label>Comment ça marche</Label>
        <h2 class="display-section">Du dépôt à la production, sans infrastructure à gérer.</h2>
        <p class="lead">
          Forgeron se place au-dessus de Cloudflare Workers. Vous poussez votre code ; la plateforme le versionne,
          applique les accès et le sert partout.
        </p>
      </div>
      <Frame class="flow">
        <div class="node" style="flex: 1 1 180px;">
          <Label>01 · Code</Label>
          <strong>Votre dépôt GitHub</strong>
          <span class="text-code-inline muted">forgeron.config.ts</span>
        </div>
        <div class="wire" aria-hidden="true"></div>
        <div class="node invert" style="flex: 1.4 1 240px;">
          <Label>02 · Forgeron</Label>
          <strong>La plateforme</strong>
          <div class="row-wrap">
            {["Versions", "Accès", "SSO", "Journal", "Connecteurs"].map((c) => <Badge mono>{c}</Badge>)}
          </div>
        </div>
        <div class="wire" aria-hidden="true"></div>
        <div class="node" style="flex: 1 1 180px;">
          <Label>03 · Exécution</Label>
          <strong>Cloudflare Workers</strong>
          <span class="text-small muted">Un worker par tool et par environnement</span>
        </div>
        <div class="wire" aria-hidden="true"></div>
        <div class="stack-3" style="flex: 1.2 1 220px; gap: var(--space-2);">
          {
            [
              ["Claude", "MCP"],
              ["Vos applications", "API"],
              ["Navigateur", "Web"],
              ["Terminal", "CLI"],
            ].map(([who, iface]) => (
              <div class="node sm">
                <strong>{who}</strong>
                <Badge mono>{iface}</Badge>
              </div>
            ))
          }
        </div>
      </Frame>
    </section>

    <section class="wrap section two-col">
      <div class="col">
        <div class="stack-3">
          <Label>Versions</Label>
          <h2 class="display-block">Chaque push devient une version.</h2>
          <p class="muted">
            Testez en preview, ouvrez en pilote à un groupe, puis passez en production. Revenir en arrière tient en
            un clic.
          </p>
        </div>
        <div class="card">
          {
            deployments.map((d) => (
              <div class="deploy">
                <span class="ver text-code-inline">{d.version}</span>
                <span class="msg">
                  <strong>{d.message}</strong>
                  <span class="text-code-inline muted">{d.meta}</span>
                </span>
                <EnvTag env={d.env} />
                {d.state === "warning" ? (
                  <Badge tone="warning" dot>Build en cours</Badge>
                ) : (
                  <Badge tone="success" dot>En ligne</Badge>
                )}
              </div>
            ))
          }
        </div>
      </div>
      <div class="col">
        <div class="stack-3">
          <Label>Accès</Label>
          <h2 class="display-block">Qui peut faire quoi, action par action.</h2>
          <p class="muted">
            Les permissions sont déclarées dans le SDK et réglées dans le tableau de bord. Connexion par le SSO de
            l'entreprise, journal de qui utilise quel tool.
          </p>
        </div>
        <div class="card scroll-x">
          <table class="perm">
            <thead>
              <tr>
                <th scope="col" style="text-align: left;" class="text-caption">Action</th>
                {roles.map((r) => <th scope="col" class="text-caption">{r}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                permissions.map((p) => (
                  <tr>
                    <th scope="row">
                      <span class="name text-code-inline">{p.name}</span>
                      <span class="text-caption muted">{p.kind}</span>
                    </th>
                    {p.grants.map((granted) => (
                      <td>
                        <span
                          class={granted ? "check check-on" : "check"}
                          role="img"
                          aria-label={granted ? "Autorisé" : "Refusé"}
                        />
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="modeles" class="wrap section stack-3" style="gap: 40px;">
      <div class="head-row">
        <div class="section-head">
          <Label>Modèles</Label>
          <h2 class="display-section">Partez d'une base. Forgez le reste.</h2>
        </div>
        <Button href="#modeles">Voir tous les modèles</Button>
      </div>
      <div class="grid-4">
        {
          templates.map((t) => (
            <a href="#modeles" class="card">
              <span class="text-code-inline muted">{t.path}</span>
              <span class="text-title-3">{t.name}</span>
              <span class="muted">{t.text}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section id="sdk" class="wrap section split">
      <div class="stack-3" style="gap: 20px;">
        <Label>Vues</Label>
        <h2 class="display-section" style="font-size: clamp(32px, 4.5vw, 44px);">
          Des tableaux de bord légers, en React.
        </h2>
        <p class="lead">
          Quand une conversation ne suffit pas, écrivez une page React. Le SDK y injecte les données du tool, avec
          les droits de la personne connectée.
        </p>
        <div class="row-wrap" style="gap: var(--space-2);">
          <Badge mono>useAction</Badge><Badge mono>useUser</Badge><Badge mono>defineView</Badge>
        </div>
      </div>
      <Frame class="frame-pad">
        <CodeCard title="views/pipeline.tsx" lines={viewCode} />
      </Frame>
    </section>

    <section id="hebergement" class="wrap section stack-3" style="gap: 40px;">
      <div class="section-head center stack-3">
        <Label>Hébergement</Label>
        <h2 class="display-section">Chez nous ou chez vous.</h2>
      </div>
      <div class="grid-2">
        <div class="card tile">
          <Label>Self-host</Label>
          <span class="display-block">Open source</span>
          <span class="muted">
            Déployez Forgeron sur votre propre compte Cloudflare. Le SDK, la plateforme et les modèles sont ouverts.
          </span>
          <Button href="#github" class="push">Voir sur GitHub</Button>
        </div>
        <div class="card tile invert">
          <Label>Forgeron Cloud</Label>
          <span class="display-block">
            [PRIX] € <span class="text-body muted" style="letter-spacing: 0;">/ siège / mois</span>
          </span>
          <span class="muted">
            Un seul plan : tous les outils, les connecteurs, le SSO entreprise et les versions, hébergés pour vous.
          </span>
          <Button href="#commencer" class="push on-invert">Commencer</Button>
        </div>
      </div>
    </section>

    <section id="commencer" class="wrap" style="padding-top: 32px; padding-bottom: 96px;">
      <Frame class="cta">
        <Logo variant="symbol" size={56} />
        <h2>Votre premier tool en cinq minutes.</h2>
        <div class="hero-actions">
          <Button href="#commencer" variant="primary" size="lg">Commencer gratuitement</Button>
          <Button href="#docs" size="lg">Lire la documentation</Button>
        </div>
      </Frame>
    </section>
  </main>

  <Footer />
</Base>
