---
import {
  AnvilIcon,
  ApiIcon,
  BoltIcon,
  BookOpen01Icon,
  BrowserIcon,
  ChartIcon,
  Clock01Icon,
  CloudflareIcon,
  CommandLineIcon,
  CustomerSupportIcon,
  DatabaseIcon,
  DeployIcon,
  EyeIcon,
  GitBranchIcon,
  GitForkIcon,
  GlobeIcon,
  Key01Icon,
  Layers01Icon,
  LockIcon,
  LogIcon,
  Mail01Icon,
  McpIcon,
  Note01Icon,
  Robot01Icon,
  RollbackIcon,
  Search01Icon,
  Shield01Icon,
  Ticket01Icon,
  UserGroupIcon,
} from "@forgeron/icons";
import {
  ArtCard,
  Bento,
  BentoCell,
  CardGrid,
  Command,
  CtaBand,
  Faq,
  Hero,
  Icon,
  LogoStrip,
  MarkBadge,
  PlanCard,
  PlanGrid,
  SectionBand,
  SectionHead,
  SiteNav,
  SoonTag,
  StoryList,
  StoryStep,
  Title,
} from "@forgeron/ui";
import Footer from "../components/Footer.astro";
import Site from "../layouts/Site.astro";
import { plans } from "../data/plans";

/** The public repository (Apache-2.0) and its documentation. */
const GITHUB = "https://github.com/forgeron-sh/monorepo";
const DOCS = "https://github.com/forgeron-sh/monorepo/blob/main/docs/sdk.md";


/** The opening's captions, one per step of the story (ranges in `STEPS`, illustrations/village.ts). */
const sagaSteps: { step: string; title: string; pos: "top" | "tl" | "tr" | "bl" | "br" }[] = [
  { step: "intro", title: "Anatomy of a fall.", pos: "tr" },
  { step: "complex", title: "It does everything, all at once, and none of it is simple.", pos: "tl" },
  { step: "unfit", title: "None of it fits the way you work, and every module is billed.", pos: "tr" },
  { step: "excel", title: "So the real work moves to spreadsheets next door.", pos: "tl" },
  { step: "tinker", title: "It tinkers to catch up: custom patches, nailed on wherever it hurts.", pos: "bl" },
  { step: "upgrade", title: "Then every upgrade is a building site, and the patches do not survive it.", pos: "bl" },
  { step: "generic", title: "It goes generic, and every need becomes a gas factory.", pos: "tl" },
  { step: "plug", title: "It plugs into twenty thousand services, give or take.", pos: "bl" },
  { step: "ai", title: "Everyone else has AI. Here, half of it is plugged in, and that half misfires.", pos: "tl" },
  { step: "lockin", title: "And once you are in, you are fenced in: your data has no way out.", pos: "br" },
  { step: "support", title: "Every question it cannot answer becomes one more ticket on the pile.", pos: "br" },
  { step: "boom", title: "Until the whole thing blows.", pos: "bl" },
];

/** The opening's table of contents: a short name per step, in the story's order. */
const sagaToc: { step: string; name: string }[] = [
  { step: "intro", name: "The village" },
  { step: "complex", name: "Complexity" },
  { step: "unfit", name: "Your bank account" },
  { step: "excel", name: "Shadow Excel" },
  { step: "tinker", name: "Custom patches" },
  { step: "upgrade", name: "Upgrades" },
  { step: "generic", name: "Gas factory" },
  { step: "plug", name: "Connectors" },
  { step: "ai", name: "AI" },
  { step: "lockin", name: "Vendor lock-in" },
  { step: "support", name: "Support" },
  { step: "boom", name: "Explosion" },
];

/**
 * Who uses Forgeron, shown in a band before the system section. Real names only: leave the list
 * empty rather than invent one; empty slots render as hatched cells until it is filled.
 */
const users: string[] = [];
const userSlots = 4;

/** A pixel Y on an ember square: the Y Combinator mark, redrawn in the bitmap face, in the page's
 * one orange (`--accent`) with black (`--accent-ink`) on it. */
const ycMark = (() => {
  const y = ["#...#", "#...#", ".#.#.", "..#..", "..#..", "..#..", "..#.."];
  let d = "";
  y.forEach((row, r) => [...row].forEach((c, x) => (d += c === "#" ? `M${x + 2} ${r + 2}h1v1h-1z` : "")));
  return `<svg viewBox="0 0 9 11" shape-rendering="crispEdges" aria-hidden="true"><rect width="9" height="11" style="fill:var(--accent)"/><path style="fill:var(--accent-ink)" d="${d}"/></svg>`;
})();

const proof = [
  { icon: CloudflareIcon, text: "Cloudflare" },
  { icon: AnvilIcon, text: "Apache-2.0" },
  { icon: LockIcon, text: "Company SSO" },
];

/** Step 01: the catalog. Only the first three exist as templates today; the rest wear `Soon`. */
const catalog = [
  { name: "CRM", icon: UserGroupIcon, text: "Companies, contacts, deals", soon: false },
  { name: "Data hub", icon: DatabaseIcon, text: "Imports and syncs", soon: false },
  { name: "Dashboard", icon: ChartIcon, text: "Sales at a glance", soon: false },
  { name: "Help desk", icon: CustomerSupportIcon, text: "Requests, answers", soon: true },
  { name: "Ticketing", icon: Ticket01Icon, text: "Boards and issues", soon: true },
  { name: "Notes", icon: Note01Icon, text: "Pages for the team", soon: true },
];

/** Step 02: recipes the AI follows to add a feature (announced); the open one lists its documents. */
const recipes: { name: string; size?: string; docs?: { path: string; what: string }[] }[] = [
  { name: "Add a field", size: "3 files" },
  {
    name: "Renewals",
    docs: [
      { path: "RECIPE.md", what: "the method" },
      { path: "schema/renewal.ts", what: "field" },
      { path: "actions/renewals.ts", what: "action" },
      { path: "views/renewals.tsx", what: "page" },
      { path: "renewals.test.ts", what: "test" },
    ],
  },
  { name: "Weekly digest", size: "4 files" },
];

/** Step 02: plugins a tool comes with (announced). */
const plugins = [
  { name: "Kanban board", on: true },
  { name: "Email sync", on: false },
  { name: "Odoo bridge", on: true },
  { name: "Renewals", on: true, added: true },
];

/** Step 03: the four doors, grouped by who walks through them. */
const doorGroups = [
  {
    who: "For your people",
    doors: [{ name: "Web", iso: "web", icon: BrowserIcon, text: "Its own interface, behind your SSO." }],
  },
  {
    who: "For your agents",
    doors: [
      { name: "MCP", iso: "mcp", icon: McpIcon, text: "Claude uses the tool, with each person's rights." },
      { name: "CLI", iso: "cli", icon: CommandLineIcon, text: "forgeron crm deals move, for coding agents and you." },
    ],
  },
  {
    who: "For your applications",
    doors: [{ name: "API", iso: "api", icon: ApiIcon, text: "An endpoint per action, for your integrations." }],
  },
];

/** Under the hood: the six layers of a tool, top to bottom (the order of `LAYERS` in the drawing). */
const layers = [
  { i: 0, icon: McpIcon, name: "Interfaces", text: "Web, CLI, MCP and API, from one definition." },
  { i: 1, icon: LockIcon, name: "Access", text: "Company SSO, teams, permissions per action." },
  { i: 2, icon: AnvilIcon, name: "Tools", text: "Versioned on every push, previewed before production." },
  { i: 3, icon: ChartIcon, name: "Observability", text: "Calls, time per call, errors and logs." },
  { i: 4, icon: DatabaseIcon, name: "Data", text: "Tables, files, and one vault for secrets." },
  { i: 5, icon: CloudflareIcon, name: "Runtime", text: "Cloudflare Workers. Hosted by us or by you." },
];
const left = layers.slice(0, 3);
const right = layers.slice(3);

/** Clockwise from noon in the drawing, in this order. */
const resources = [
  { i: 0, icon: DatabaseIcon, name: "Database", text: "Its own SQL database, per environment." },
  { i: 1, icon: BookOpen01Icon, name: "Files", text: "Uploads and exports, with size and type limits." },
  { i: 2, icon: BoltIcon, name: "Cache", text: "Keys it reads often, served fast." },
  { i: 3, icon: Key01Icon, name: "Secrets", text: "The app's keys and each person's, in one vault." },
  { i: 4, icon: LogIcon, name: "Queue", text: "Work handed off and run in the background." },
  { i: 5, icon: Mail01Icon, name: "Mail", text: "Sends and receives mail, from the tool itself." },
  { i: 6, icon: Clock01Icon, name: "Cron jobs", text: "Runs on a schedule, in your time zone." },
  { i: 7, icon: ChartIcon, name: "Observability", text: "What it does, how fast, for whom." },
  { i: 8, icon: GlobeIcon, name: "Realtime", text: "Channels, messages and presence, live." },
];


const access = [
  {
    iso: "badge-gate",
    icon: LockIcon,
    name: "Company SSO",
    text: "Your teams sign in with the identity provider you already use.",
  },
  {
    iso: "dashboard",
    icon: ChartIcon,
    name: "Every call, measured",
    text: "Calls, time per call, errors and logs, per tool, with no setup.",
  },
  {
    iso: "ledger",
    icon: LogIcon,
    name: "Audit log",
    text: "Usage, deployments and every change, with who made them.",
  },
];


/** The develop section's stops, in the order the package reaches them. */
const stops = [
  { n: "01", name: "Local", text: "forgeron dev runs the tool on your machine, with local data." },
  { n: "02", name: "Preview", text: "Every branch gets its own link, to share before it ships." },
  { n: "03", name: "Production", text: "A release goes live. forgeron rollback takes it back." },
];







const faq = [
  {
    q: "What is a tool?",
    a: "A business application your team uses: a CRM, a help desk, a dashboard. Underneath, it is a folder of actions; Forgeron serves each one on the web, in the terminal, over the API and to Claude.",
  },
  {
    q: "Can I change a tool I installed?",
    a: "Yes. Fork it, ask the AI for what you need, try it in a preview, then ship it. Every change is a version you can roll back.",
  },
  {
    q: "How do agents use my tools?",
    a: "Over MCP, with the rights of the person they work for, or with a token. Every call goes through the same gateway and lands in the audit log.",
  },
  {
    q: "Do I need servers?",
    a: "No. Each tool runs as its own Cloudflare Worker, per environment, with its own database, files and cache.",
  },
  {
    q: "Can I host it myself?",
    a: "Yes. The same platform installs on your own Cloudflare account with the forgeron CLI. Or let us run it on Forgeron Cloud.",
  },
  { q: "Is it open source?", a: "Yes, under the Apache-2.0 license." },
];
---

<Site
  title="Forgeron — Forge your internal tools"
  description="Write an internal tool once with the Forgeron SDK. Your teams use it from Claude (MCP), the API, the web and the terminal, behind your company's SSO, on Cloudflare Workers. Open source, Apache-2.0."
  bodyClass="home"
>
  <SiteNav
    github={GITHUB}
    start="#start"
    links={[
      { href: "#how", label: "How it works" },
      { href: "#anatomy", label: "Anatomy" },
      { href: "#resources", label: "Resources" },
      { href: "#access", label: "Access" },
      { href: "#develop", label: "Develop" },
      { href: "#host", label: "Hosting" },
      { href: "/pricing", label: "Pricing" },
    ]}
  />

  <main>
    <!-- HERO: banner image, then title and call to action -->
    <section id="top" class="saga">
      <div class="saga-stage">
        <figure class="saga-screen">
          <canvas class="saga-bg" data-shader="field" data-px="4" data-accent="off" aria-hidden="true"></canvas>
          <div class="saga-cam">
            <canvas data-iso="erp-village" data-scale="2" data-unit="any" data-fill="0.98" data-signal="--success" aria-hidden="true"></canvas>
          </div>
          <figcaption class="sr-only">
            An island of absurd machines around an ERP: a slot machine eating your bank account, a CRM wheel throwing
            contacts away, a support tank under pressure. As you scroll, the ERP tinkers, goes generic, plugs into
            everything, explodes, and the village burns.
          </figcaption>
        </figure>
        <canvas class="saga-burn" aria-hidden="true"></canvas>
        <p class="saga-live text-eyebrow"><span class="saga-dot" aria-hidden="true"></span>Live</p>
        <button type="button" class="saga-skip text-eyebrow">Skip intro</button>
        <nav class="saga-toc" aria-label="Chapters">
          <ol>
            {
              sagaToc.map((c, i) => (
                <li hidden={i > 0}>
                  <button type="button" data-goto={c.step}>
                    <span class="saga-toc-n">{String(i + 1).padStart(2, "0")}</span>
                    {c.name}
                  </button>
                </li>
              ))
            }
          </ol>
        </nav>
        <ol class="saga-captions">
          {
            sagaSteps.map((c) => (
              <li data-step={c.step} data-pos={c.pos} hidden={c.step !== "intro"}>
                <Title as="h2" size="h2">{c.title}</Title>
              </li>
            ))
          }
        </ol>
        <div class="saga-hero fg-rail hero-d">
          <Hero
            title={["Forge your", "internal tools."]}
            proof={proof}
            lead="Pick a ready-made tool. Shape it to your team with AI. Ship it to your people and your agents."
            action={{ href: "#start", label: "Get started" }}
          >
            <Command slot="command" framed={false}>npx forgeron init</Command>
            <MarkBadge slot="badge">
              <Fragment slot="mark" set:html={ycMark} />
              Not backed by Y Combinator
            </MarkBadge>
          </Hero>
          <!-- USED BY: a band of names, in the style of the font site's facts strip, closing the hero -->
          <section class="users" aria-label="Who uses Forgeron">
            <LogoStrip label="Forging at" names={users} slots={userSlots} />
          </section>
        </div>
      </div>
    </section>

    <!-- 0.1 HOW IT WORKS: pick, shape, ship -->
    <section id="how" class="fg-rail">
      <SectionHead
        index="/0.1"
        title={["Pick. Shape.", "Ship."]}
        lead="From a tool that already works to a tool that fits your team, live for your people and your agents."
      />

      <StoryList>
        <!-- 01 PICK -->
        <StoryStep
          id="pick"
          n="01"
          label="Step 1"
          title="Start from a tool that already works."
          text="A CRM, a help desk, a notes app: browse finished tools and install one."
          points={[
            { icon: DeployIcon, text: "Installed in one click" },
            { icon: RollbackIcon, text: "Kept up to date by its maintainers" },
            { icon: GitForkIcon, text: "Yours to fork" },
          ]}
        >
            <div class="catalog">
              <div class="catalog-bar text-eyebrow">
                <Icon icon={Search01Icon} size={12} />
                <span class="dim">Search the catalog</span>
              </div>
              <ul class="catalog-grid">
                {
                  catalog.map((c, i) => (
                    <li class:list={["catalog-card", { on: i === 0, soon: c.soon }]}>
                      <Icon icon={c.icon} size={24} variant="duo" />
                      <span class="catalog-name">{c.name}</span>
                      <span class="text-eyebrow dim">{c.text}</span>
                      {c.soon ? (
                        <SoonTag />
                      ) : i === 0 ? (
                        <span class="fg-btn fg-btn-primary fg-btn-sm catalog-btn">Install</span>
                      ) : (
                        <span class="fg-btn fg-btn-sm catalog-btn">Install</span>
                      )}
                    </li>
                  ))
                }
              </ul>
            </div>
        </StoryStep>

        <!-- 02 SHAPE -->
        <StoryStep
          id="shape"
          n="02"
          label="Step 2"
          title="Make it fit your team, with AI."
          text="Pick a recipe, or ask for your own. Recipes and plugins hand the AI tested code and the method to add it."
          points={[
            { icon: EyeIcon, text: "A preview for every change" },
            { icon: GitBranchIcon, text: "Every change, a version" },
            { icon: Layers01Icon, text: "Recipes: documents the AI follows" },
          ]}
        >
            <div class="shape">
              <ul class="shape-plugins shape-recipes">
                <li class="text-eyebrow shape-head"><span>Recipes</span><SoonTag /></li>
                {
                  recipes.map((r) =>
                    r.docs ? (
                      <li class="recipe-open">
                        <span class="text-eyebrow recipe-name">
                          <span>{r.name}</span>
                          <span class="fg-btn fg-btn-primary fg-btn-sm">Apply</span>
                        </span>
                        <ul class="recipe-docs">
                          {r.docs.map((d) => (
                            <li class="text-eyebrow">
                              <Icon icon={LogIcon} size={12} />
                              <span>{d.path}</span>
                              <span class="dim">{d.what}</span>
                            </li>
                          ))}
                        </ul>
                      </li>
                    ) : (
                      <li class="text-eyebrow">
                        <span>{r.name}</span>
                        <span class="dim">{r.size}</span>
                      </li>
                    ),
                  )
                }
              </ul>
              <ul class="shape-plugins">
                <li class="text-eyebrow shape-head"><span>Plugins</span><SoonTag /></li>
                {
                  plugins.map((p) => (
                    <li class:list={["text-eyebrow", { added: p.added }]}>
                      <span>{p.name}</span>
                      <span class:list={["toggle", { on: p.on }]} aria-hidden="true"><span /></span>
                    </li>
                  ))
                }
              </ul>
            </div>
        </StoryStep>

        <!-- 03 SHIP -->
        <StoryStep
          id="ship"
          n="03"
          label="Step 3"
          title="Out to your people and your agents."
          text="One click, and the tool is live on the web, in the terminal, over the API and in Claude, behind your SSO."
          points={[
            { icon: DeployIcon, text: "One click to production" },
            { icon: Shield01Icon, text: "The same rights on every door" },
            { icon: Robot01Icon, text: "Made for agents, not bolted on" },
          ]}
          dots={false}
          artClassName="ship-art"
        >
            {
              doorGroups.map((g) => (
                <div class="ship-group" style={`--n:${g.doors.length}`}>
                  <span class="text-eyebrow dim ship-who">{g.who}</span>
                  <div class="ship-doors">
                    {g.doors.map((d) => (
                      <article class="ship-door">
                        <div class="ship-door-art fg-dots">
                          <canvas data-iso={d.iso} data-scale="2" data-fill="0.6" aria-hidden="true" />
                        </div>
                        <div class="ship-door-copy">
                          <span class="ship-door-name">
                            <Icon icon={d.icon} size={24} />
                            <span class="text-title-3">{d.name}</span>
                          </span>
                          <span class="text-eyebrow dim">{d.text}</span>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              ))
            }
        </StoryStep>
      </StoryList>
    </section>

    <SectionBand className="fg-rail" from="/0.1" to="/0.2" label="Under the hood" />

    <!-- 0.2 ANATOMY -->
    <section id="anatomy" class="fg-rail">
      <SectionHead
        index="/0.2"
        title={["One framework,", "six layers."]}
        lead="What the platform stacks under every tool, so your change only touches what makes it yours."
      />
      <div class="stack">
        <ul class="stack-col">
          {
            left.map((l) => (
              <li data-layer={l.i} class="fg-ticks">
                <span class="layer-head">
                  <Icon icon={l.icon} />
                </span>
                <span class="text-title-3">{l.name}</span>
                <span class="text-small muted">{l.text}</span>
              </li>
            ))
          }
        </ul>
        <div class="stack-art fg-dots">
          <canvas id="stack-canvas" data-iso="stack6" data-scale="2" data-fill="0.78" data-unit="any" aria-hidden="true"></canvas>
        </div>
        <ul class="stack-col stack-col-r">
          {
            right.map((l) => (
              <li data-layer={l.i} class="fg-ticks">
                <span class="layer-head">
                  <Icon icon={l.icon} />
                </span>
                <span class="text-title-3">{l.name}</span>
                <span class="text-small muted">{l.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <SectionBand className="fg-rail" from="/0.2" to="/0.3" label="Resources" />

    <!-- 0.3 RESOURCES -->
    <section id="resources" class="fg-rail">
      <SectionHead
        index="/0.3"
        title={["Everything", "on tap."]}
        lead="A tool lists what it needs; the platform hands it over, one per tool and environment."
      />
      <div class="res">
        <div class="res-art fg-dots">
          <canvas id="res-canvas" data-iso="resources" data-cycle="2" data-count="9" data-scale="2" data-fill="0.94" data-unit="any" aria-hidden="true"></canvas>
        </div>
        <ul class="res-list">
          {
            resources.map((r) => (
              <li data-res={r.i} class="fg-ticks">
                <Icon icon={r.icon} />
                <div>
                  <span class="text-title-3">{r.name}</span>
                  <p class="text-small muted">{r.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <SectionBand className="fg-rail" from="/0.3" to="/0.4" label="Access" />

    <!-- 0.5 ACCESS -->
    <section id="access" class="fg-rail">
      <SectionHead
        index="/0.4"
        title={["Who did what,", "with which rights."]}
        lead="Every door goes through the same gateway: sign-in, team check, audit log. None bypasses another."
      />
      <CardGrid>
        {
          access.map((a) => (
            <ArtCard icon={a.icon} title={a.name} text={a.text}>
              <canvas slot="art" data-iso={a.iso} data-scale="2" data-fill="0.8" data-unit="any" aria-hidden="true" />
            </ArtCard>
          ))
        }
      </CardGrid>
    </section>

    <SectionBand className="fg-rail" from="/0.4" to="/0.5" label="Develop" />

    <!-- 0.6 DEVELOP: a pinned production line -->
    <section id="develop" class="fg-rail">
      <div class="line-track">
        <div class="line-pin">
          <SectionHead
            index="/0.5"
            title={["From your laptop", "to everyone."]}
            lead="Try a tool locally, share it in a preview, publish it. In your terminal, or from Claude."
          />
          <div class="line-art fg-dots">
            <canvas id="line-canvas" data-iso="production-line" data-scale="2" data-fill="0.84" data-unit="any" aria-hidden="true"></canvas>
          </div>
          <ol class="line-stops">
            {
              stops.map((s, i) => (
                <li data-stop={i} class:list={["fg-ticks", { on: i === 0 }]}>
                  <span class="text-eyebrow accent">{s.n}</span>
                  <span class="text-title-3">{s.name}</span>
                  <span class="text-small muted">{s.text}</span>
                </li>
              ))
            }
          </ol>
          <!-- The hosting head rides in the pin, under the stops: it is already in view while the
               package travels, and the plans follow it straight after. -->
          <SectionBand from="/0.5" to="/0.6" label="Hosting" />
          <div id="host" class="host-head">
            <SectionHead
              index="/0.6"
              title={["Our cloud,", "or yours."]}
              lead="The same platform in every case. Only who runs it changes."
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 0.7 HOSTING -->
    <section class="fg-rail host">
      <PlanGrid>
        {
          plans.map((p, i) => (
            <PlanCard
              name={p.name}
              icon={p.icon}
              tag={p.tag}
              where={p.where}
              groups={p.groups}
              featured={i === 0}
              action={i === 0 ? { href: "/pricing", label: "See pricing", primary: true, marker: true } : p.action}
            >
              <canvas data-iso={p.iso} data-scale="2" data-fill="0.8" data-unit="any" aria-hidden="true" />
            </PlanCard>
          ))
        }
      </PlanGrid>
    </section>

    <SectionBand className="fg-rail" from="/0.6" to="/0.7" label="Extras" />

    <!-- 0.8 EXTRAS -->
    <section id="extras" class="fg-rail">
      <SectionHead index="/0.7" title={["The small", "extras."]} />
      <Bento>
        <BentoCell span={2} rows={3} title="Usage per team" text="One unit for everything a tool runs: CPU, storage, crons. Heavy storage and light CPU even out, with no overage per resource. AI spend beside it (soon).">
          <canvas slot="art" data-iso="usage-iso" data-scale="2" data-fill="0.86" data-unit="any" aria-hidden="true"></canvas>
        </BentoCell>
        <BentoCell span={2} rows={3} title="One AI gateway" text="Every model behind one entry, and who calls what.">
          <SoonTag slot="corner" />
          <canvas slot="art" data-iso="ai-gateway" data-scale="2" data-fill="0.86" data-unit="any" aria-hidden="true"></canvas>
        </BentoCell>
        <BentoCell span={2} rows={3} title="One vault" text="Application secrets and each person's own keys, sealed together. Nobody reads them back.">
          <canvas slot="art" data-iso="safe" data-scale="2" data-fill="0.74" data-unit="any" aria-hidden="true"></canvas>
        </BentoCell>
        <BentoCell span={2} rows={3} title="Teams and permissions" text="Access given to teams, action by action, on every door at once.">
          <canvas slot="art" data-iso="permissions-iso" data-scale="2" data-fill="0.84" data-unit="any" aria-hidden="true"></canvas>
        </BentoCell>
