---
import Site from "../layouts/Site.astro";
---

<Site title="A wild ERP appeared · Forgeron" description="A handheld battle: each tool Forgeron forges knocks a module off the ERP suite.">
  <main class="wild">
    <figure class="screen">
      <canvas id="wild-erp" aria-hidden="true"></canvas>
      <figcaption class="sr-only">
        A handheld battle screen. A wild ERP suite appears; Forgeron forges a CRM, a billing and a stock tool, each one
        knocking a module off the suite, until it faints and your team asks Claude instead.
      </figcaption>
    </figure>
  </main>
</Site>

<script>
  import { mountFlat } from "../illustrations/flat";

  const el = document.getElementById("wild-erp");
  if (el instanceof HTMLCanvasElement) mountFlat(el, 4).show("erp");
</script>

<style>
  :global(body) {
    background: #000;
  }
  .wild {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 16px;
  }
  .screen {
    position: relative;
    margin: 0;
    width: min(960px, calc(100vw - 32px), calc((100dvh - 32px) * 1.6));
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line-strong);
    background: var(--bg-sunk);
  }
  .screen canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
</style>
