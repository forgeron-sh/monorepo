---
import "@forgeron/ui/styles.css";
import { ArchitecturePreview } from "../../components/ArchitecturePreview";
import Site from "../../layouts/Site.astro";
---

<Site
  title="Architecture diagram — Forgeron design system"
  description="The architecture diagram of a tool, drawn from its manifest."
>
  <main class="arch-page">
    <h1>Architecture diagram</h1>
    <p>
      Drawn from a tool's manifest: interfaces on the left, action groups with their access level in
      the middle, resources on the right, then profiles, events, scheduled tasks and the tools it uses.
      Below: the manifests of the four templates.
    </p>
    <ArchitecturePreview client:load />
  </main>
</Site>

<style>
  .arch-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-8) 16px var(--space-16);
    color: var(--ink);
  }
  .arch-page h1 {
    font: 500 32px/40px var(--font-sans);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2);
  }
  .arch-page p {
    color: var(--ink-muted);
    max-width: 64ch;
    margin: 0 0 var(--space-6);
  }
  :global(.arch-controls) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  :global(.tabs) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  :global(.tab) {
    height: 30px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  :global(.tab:hover) {
    color: var(--ink);
    border-color: var(--ink);
  }
  :global(.tab-on),
  :global(.tab-on:hover) {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  :global(.tab:focus-visible) {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
  :global(.arch-panel) {
    border: 1px solid var(--line);
    background: var(--bg);
    padding: var(--space-6);
  }
  @media (max-width: 640px) {
    :global(.tabs) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  :global(.tab) {
    height: 30px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  :global(.tab:hover) {
    color: var(--ink);
    border-color: var(--ink);
  }
  :global(.tab-on),
  :global(.tab-on:hover) {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  :global(.tab:focus-visible) {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
  :global(.arch-panel) {
      padding: var(--space-3);
    }
  }
</style>
