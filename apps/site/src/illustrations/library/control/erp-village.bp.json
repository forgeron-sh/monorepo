{
  "$schema": "https://blueprint.forgeron.sh/schema/v1.json",
  "version": 1,
  "id": "site/control/erp-village",
  "scenes": {
    "erp-village": {
      "title": "The ERP village",
      "description": "An island of absurd machines around an ERP, told in fourteen steps as the page scrolls: it tinkers, goes generic, plugs into everything, breaks and burns.",
      "depth": "painter",
      "root": {
        "instances": []
      },
      "camera": {
        "view": 0,
        "fit": {
          "fill": 0.98,
          "unit": "any",
          "box": {
            "min": [-42, -36, -1.2],
            "max": [36, 36, 20]
          }
        },
        "shots": {
          "intro": {
            "at": [0, 0, 0],
            "zoom": 1
          },
          "complex": {
            "at": [0, 0, 8],
            "zoom": 1.7
          },
          "unfit": {
            "at": [-1, -49, 5],
            "zoom": 1.8
          },
          "excel": {
            "at": [6, 20, 2],
            "zoom": 1.9
          },
          "tinker": {
            "at": [20, 18, 3],
            "zoom": 1.9
          },
          "upgrade": {
            "at": [6, -6, 10],
            "zoom": 1.45
          },
          "generic": {
            "at": [0, 0, 11],
            "zoom": 1.6
          },
          "plug": {
            "at": [-8, -42, 6],
            "zoom": 1.35
          },
          "ai": {
            "at": [-42, 9, 3],
            "zoom": 1.7
          },
          "lockin": {
            "at": [-30, 33, 3],
            "zoom": 1.7
          },
          "support": {
            "at": [-27, -26, 3],
            "zoom": 1.9
          },
          "boom": {
            "at": [0, 0, 0],
            "zoom": 1
          },
          "fire": {
            "at": [0, 0, 5],
            "zoom": 1.7
          },
          "out": {
            "at": [0, 0, 9],
            "zoom": 1.35
          }
        }
      },
      "vars": {
        "progress": {
          "type": "progress",
          "default": 0
        }
      },
      "machines": {
        "story": {
          "initial": "intro",
          "states": {
            "intro": {
              "shot": "intro"
            },
            "complex": {
              "shot": "complex"
            },
            "unfit": {
              "shot": "unfit"
            },
            "excel": {
              "shot": "excel"
            },
            "tinker": {
              "shot": "tinker"
            },
            "upgrade": {
              "shot": "upgrade"
            },
            "generic": {
              "shot": "generic"
            },
            "plug": {
              "shot": "plug"
            },
            "ai": {
              "shot": "ai"
            },
            "lockin": {
              "shot": "lockin"
            },
            "support": {
              "shot": "support"
            },
            "boom": {
              "shot": "boom"
            },
            "fire": {
              "shot": "fire"
            },
            "out": {
              "shot": "out"
            }
          },
          "transitions": [
            {
              "from": "*",
              "to": "intro",
              "when": {
                "var": "progress",
                "range": [0, 0.05]
              }
            },
            {
              "from": "*",
              "to": "complex",
              "when": {
                "var": "progress",
                "range": [0.05, 0.105]
              }
            },
            {
              "from": "*",
              "to": "unfit",
              "when": {
                "var": "progress",
                "range": [0.105, 0.16]
              }
            },
            {
              "from": "*",
              "to": "excel",
              "when": {
                "var": "progress",
                "range": [0.16, 0.215]
              }
            },
            {
              "from": "*",
              "to": "tinker",
              "when": {
                "var": "progress",
                "range": [0.215, 0.27]
              }
            },
            {
              "from": "*",
              "to": "upgrade",
              "when": {
                "var": "progress",
                "range": [0.27, 0.33]
              }
            },
            {
              "from": "*",
              "to": "generic",
              "when": {
                "var": "progress",
                "range": [0.33, 0.39]
              }
            },
            {
              "from": "*",
              "to": "plug",
              "when": {
                "var": "progress",
                "range": [0.39, 0.45]
              }
            },
            {
              "from": "*",
              "to": "ai",
              "when": {
                "var": "progress",
                "range": [0.45, 0.51]
              }
            },
            {
              "from": "*",
              "to": "lockin",
              "when": {
                "var": "progress",
                "range": [0.51, 0.6]
              }
            },
            {
              "from": "*",
              "to": "support",
              "when": {
                "var": "progress",
                "range": [0.6, 0.69]
              }
            },
            {
              "from": "*",
              "to": "boom",
              "when": {
                "var": "progress",
                "range": [0.69, 0.8]
              }
            },
            {
              "from": "*",
              "to": "fire",
              "when": {
                "var": "progress",
                "range": [0.8, 0.9]
              }
            },
            {
              "from": "*",
              "to": "out",
              "when": {
                "var": "progress",
                "range": [0.9, 1.01]
              }
            }
          ]
        }
      }
    }
  }
}
