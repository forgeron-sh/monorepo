{
  // Skeleton: bindings and routes to fill in with the code (docs/ARCHITECTURE.md, "Hosting modes").
  "name": "forgeron-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Forgeron Cloud: the dispatch namespace the tool Workers are uploaded to (name to fill in):
  //   "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "<namespace>" }],
  // Self-host: one service binding per tool Worker, named TOOL_<WORKER> (acme--crm--production is
  // TOOL_ACME__CRM__PRODUCTION), added by redeploying the gateway when a tool is created or deleted.
  // The console (apps/console, `vite build`) is served as assets at the workspace origin. The Worker
  // runs first: `/t/<tool>`, `/console-api` and the assets are told apart in `createGateway`.
  "assets": {
    "directory": "../console/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
}
