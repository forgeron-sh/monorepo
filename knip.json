{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["assets/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"]
    },
    "packages/*": {},
    "templates/*": {
      "entry": [
        "forgeron.config.ts",
        "db/schema.ts",
        "db/migrations/*.ts",
        "actions/**/*.ts",
        "jobs/**/*.ts",
        "events/**/*.ts"
      ]
    },
    "packages/compiler": {
      "ignore": ["fixtures/**"],
      "ignoreDependencies": ["@forgeron/runtime"]
    },
    "packages/sdk": {
      "ignore": ["fixtures/**"]
    },
    "apps/*": {},
    "apps/cli": {
      "ignore": ["fixtures/**"]
    },
    "apps/gateway": {
      "ignoreDependencies": ["@cloudflare/workers-oauth-provider"]
    }
  }
}
