{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["assets/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"]
    },
    "apps/*": {},
    "packages/*": {},
    "templates/*": {
      "entry": ["forgeron.config.ts", "actions/**/*.ts", "jobs/**/*.ts", "events/**/*.ts"]
    },
    "packages/compiler": {
      "ignore": ["fixtures/**"],
      "ignoreDependencies": ["@forgeron/runtime"]
    },
    "packages/sdk": {
      "ignore": ["fixtures/**"]
    }
  }
}
