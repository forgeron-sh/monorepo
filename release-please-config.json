{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "changelog-path": "CHANGELOG.md",
  "include-component-in-tag": true,
  "packages": {
    ".": { "package-name": "", "include-component-in-tag": false },
    "packages/permissions": { "component": "permissions" },
    "packages/manifest": { "component": "manifest" },
    "packages/runtime": { "component": "runtime" },
    "packages/sdk": { "component": "sdk" },
    "apps/cli": { "component": "forgeron" }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "forgeron",
      "components": ["permissions", "manifest", "runtime", "sdk", "forgeron"]
    }
  ]
}
